# Переменные для docker-compose.prod.yml. Скопировать в
# infra/docker/.env.prod на сервере и заполнить реальными значениями —
# .env.prod не должен попадать в git (см. .gitignore).

POSTGRES_USER=ai_task_system
POSTGRES_PASSWORD=сгенерировать-длинный-случайный-пароль
POSTGRES_DB=ai_task_system

# Ровно то, что видит браузер: https://<домен API>. Запекается в клиентский
# бандл web на этапе сборки (см. apps/web/Dockerfile) — при смене домена
# нужен пересбор образа, простого docker compose up недостаточно.
API_PUBLIC_URL=https://api.example.com
