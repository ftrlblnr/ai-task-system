# Скопировать на сервере в apps/api/.env.production и заполнить реальными
# значениями — используется docker-compose.prod.yml через env_file.
# DATABASE_URL здесь не нужен — его подставляет docker-compose (хост
# "postgres" внутри docker-сети), значение из этого файла будет перекрыто.

JWT_SECRET=сгенерировать: openssl rand -base64 48
JWT_EXPIRES_IN=8h
PORT=3001

# Реальный публичный адрес Web App — используется для CORS (main.ts) и для
# редиректа после OAuth-подключения Google Calendar.
WEB_APP_URL=https://app.example.com
# Публичный адрес Telegram Mini App — второй origin в CORS (main.ts). Тот же
# адрес нужно будет указать в BotFather при регистрации Mini App (/newapp).
MINIAPP_URL=https://tg-adyutant.glb-engineering.kz

SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=сгенерировать длинный пароль, сменить после первого входа

# Telegram Mini App (раздел 14.2/14.3 ТЗ) — токен от @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINIAPP_SHORT_NAME=

# AES-256 для секретов в состоянии покоя (раздел 15 ТЗ) — сейчас хранит
# refresh-токен Google Calendar. Сгенерировать: openssl rand -base64 32
# Потеря этого ключа = невозможность расшифровать сохранённые токены
# (переподключать Google Calendar заново) — хранить отдельно и надёжно.
ENCRYPTION_KEY=

# Google Cloud Console → OAuth client (Web application). REDIRECT_URI должен
# 1-в-1 совпадать с тем, что указано в консоли.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/calendar/google/callback
# Публичный HTTPS-урл этого API — на проде уже достижим извне (в отличие
# от локальной разработки), можно включить push-уведомления Google Calendar.
GOOGLE_CALENDAR_WEBHOOK_URL=https://api.example.com/calendar/google/webhook

# Синхронизация встреч из Plaud (владелец 08.09.2026, скорректировано
# 09.09.2026) — не требует переменных окружения, см. .env.example в корне
# репозитория для полного объяснения.

# Голосовой режим Mini App (раздел 14.2 ТЗ / Адъютант) — POST /voice/parse:
# Whisper (транскрибация) + Claude (разбор в черновик задачи/события).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
