// AI Task System — схема данных Этапа 1 (Core).
// Сущности встреч/спикеров/AI-рекомендаций (раздел 18 ТЗ) добавляются
// миграциями на Этапах 3–5, когда до них дойдёт очередь по дорожной карте.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Права доступа (раздел 5 ТЗ) -------------------------------------------

enum Role {
  OWNER // Руководитель — видит всё, подтверждает AI-назначения
  EMPLOYEE // Подчинённый — видит только свои задачи и минимальный контекст
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// --- Профили (раздел 6 ТЗ) --------------------------------------------------

model Position {
  id        String     @id @default(cuid())
  title     String
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String         @id @default(cuid())
  fullName       String
  photoUrl       String?
  email          String         @unique
  passwordHash   String
  telegramId     String?        @unique
  status         EmployeeStatus @default(ACTIVE)
  role           Role           @default(EMPLOYEE)
  // Администратор профилей (раздел 6.3, 5): либо сам руководитель, либо
  // один доверенный человек — флаг, а не отдельная роль.
  isProfileAdmin Boolean        @default(false)

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  competencies EmployeeCompetency[]

  tasksAssigned Task[] @relation("TaskAssignee")
  tasksCreated  Task[] @relation("TaskCreator")
  taskWatching  TaskWatcher[]
  eventParticipations EventParticipant[]

  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  taskHistory         TaskHistory[]
  auditLogs           AuditLog[]
  telegramInvites     TelegramInvite[]
  passwordResetTokens PasswordResetToken[]
  meetingsCreated     Meeting[]

  eventsCreated            Event[]
  googleCalendarConnection GoogleCalendarConnection?
  plaudConnection          PlaudConnection?
  conversations            Conversation[]
  fileArtifacts            FileArtifact[]
  aliases                  EmployeeAlias[]
  meetingSegmentsSpoken    MeetingSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stage 2, Phase I (внешний аудит 21.09.2026, "Employee Resolver") —
// имя-варианты одного сотрудника ("Амир"/"Амиру"/"Амиром", короткие
// формы, должностные варианты), которые EmployeeResolverService
// использует В ДОПОЛНЕНИЕ к морфологической эвристике (см. её комментарий)
// при разборе assigneeRawText из голосовой команды. normalizedAlias —
// lowercase/trim/collapsed-whitespace форма alias, по ней идёт поиск;
// alias хранит оригинал для отображения в UI управления алиасами.
model EmployeeAlias {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  @@unique([employeeId, normalizedAlias])
  @@index([normalizedAlias])
}

// --- Assistant Chat (Stage 2, владелец 15.09.2026) --------------------------
// Единая лента для голоса и текста (Stage 2, Phase H, владелец 18.09.2026).
// До Phase H здесь стояла отдельная модель VoiceMessage — память голосового
// диалога (окно 3 часа) для /voice/parse, никогда не отображавшаяся ни на
// одном фронтенде (оба — apps/miniapp и apps/web — держали видимую историю
// только в localStorage). Conversation/Message/MessagePart — структурированная
// история с частями разных типов (markdown/карточки задачи-события/файл/
// статус инструмента/ошибка), а не один текстовый столбец, как раньше у
// VoiceMessage — чтобы ответ (текстовый или голосовой) мог содержать больше
// одного текстового пузыря/карточки за раз. Голос (VoiceService,
// /voice/parse) теперь тоже пишет сюда — см. комментарий в voice.service.ts.
// FileArtifact заведена в этой же миграции (нужна модели Message/Conversation
// для связи), но своей логики (хранилище, upload/download) пока не имеет —
// это отдельный этап.

enum MessageRole {
  USER
  ASSISTANT
}

// STREAMING пока не используется (нет streaming-этапа), заведён сразу,
// чтобы не потребовалась отдельная миграция только ради значения enum'а.
enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

model Conversation {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  messages      Message[]
  fileArtifacts FileArtifact[]

  @@index([employeeId, updatedAt])
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  status         MessageStatus @default(COMPLETED)
  // Идемпотентность повторной отправки (плохой интернет, двойной tap,
  // reconnect) — клиент генерирует один раз, сервер игнорирует повтор той
  // же пары (conversationId, clientRequestId). У сообщений ассистента
  // всегда null — Postgres не считает несколько NULL в уникальном индексе
  // конфликтующими, так что это не мешает.
  clientRequestId String?
  // Correlation id вызова ассистента, породившего это сообщение (тот же
  // принцип, что requestId в voice-пайплайне) — для логов, не для UI.
  requestId String?

  // Phase F.1 (стабилизация, аудит 16.09.2026) — раньше пара user↔assistant
  // определялась по "первое assistant-сообщение с createdAt позже, чем у
  // user-сообщения" — на двух устройствах, отправляющих сообщения почти
  // одновременно, это могло связать ответ B с сообщением A. Явная ссылка
  // однозначна независимо от порядка времени. У user-сообщений всегда null
  // (они ни на что не отвечают), у assistant — id того user-сообщения,
  // ответом на которое оно является. @unique (Phase F.2, аудит 17.09.2026,
  // P1.7) — бизнес-правило "один основной assistant-ответ на одно
  // user-сообщение" теперь гарантирует сама БД, а не только код;
  // AssistantChatService.createAssistantMessageIdempotent ловит гонку
  // (P2002) двух одновременных запросов с одним clientRequestId.
  replyToMessageId String? @unique
  replyToMessage   Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReply")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts         MessagePart[]
  fileArtifacts FileArtifact[]

  @@index([conversationId, createdAt])
  @@unique([conversationId, clientRequestId])
}

// Только эти 6 типов на первом этапе (см. план этапа) — markdown/error уже
// используются, остальные три ждут своего producer'а (tool-calling для
// карточек, upload/generation для файла).
enum MessagePartType {
  MARKDOWN
  TASK_CARD
  EVENT_CARD
  FILE
  TOOL_ACTIVITY
  ERROR
}

// data — Json, не отдельные колонки на каждый тип: тот же приём, что
// AuditLog.metadata, состав полей зависит от MessagePartType и валидируется
// в коде, а не схемой БД. HTML/markdown от LLM здесь не хранится как HTML —
// только markdown-текст в MarkdownPart.data.content, санитизация — на
// фронтенде при рендере.
model MessagePart {
  id        String          @id @default(cuid())
  messageId String
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MessagePartType
  order     Int
  data      Json

  @@index([messageId, order])
}

enum FileArtifactSource {
  UPLOADED
  GENERATED
  INTERNAL
}

// storageProvider/storageKey — абстракция на будущий FileStorageService
// (локальный диск в разработке, S3/MinIO/Blob позже) — ничего в этой
// модели не завязано на конкретный провайдер. conversationId/messageId
// опциональны и SetNull при удалении переписки/сообщения — сам файл может
// пережить сообщение (например, если понадобится ссылка на него из аудита).
model FileArtifact {
  id             String        @id @default(cuid())
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  name            String
  mimeType        String
  size            Int
  storageProvider String
  storageKey      String
  source          FileArtifactSource

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([employeeId, createdAt])
}

// Одноразовая привязка Telegram-аккаунта к профилю сотрудника (раздел 14.2/
// 14.3 ТЗ). Руководитель не знает numeric telegram id сотрудника заранее,
// поэтому вместо ручного ввода id — приглашение: руководитель генерирует
// токен, сотрудник переходит по deep-link в бота и подтверждает себя сам.
// Хранится только хэш токена — сырой токен отдаётся один раз при создании.
model TelegramInvite {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// Самостоятельный сброс пароля (владелец 08.09.2026: единственный путь
// раньше — прямое вмешательство в БД). Тот же token/hash/TTL паттерн, что
// у TelegramInvite выше — не отдельное изобретение, а копия уже
// проверенного подхода: сырой токен отдаётся один раз, хранится только
// его хэш, 30 минут жизни, одноразовый.
model PasswordResetToken {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// Что сотрудник умеет — компетенции. Развёрнутое описание обязательно
// (раздел 6.4: точность классификации зависит от содержательности профиля,
// не от короткого тега).
model Competency {
  id          String @id @default(cuid())
  name        String @unique
  description String

  employees    EmployeeCompetency[]
  taskProfiles TaskProfileCompetency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeCompetency {
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  // Развёрнутое описание уровня/контекста владения компетенцией у ЭТОГО
  // сотрудника, не просто факт наличия.
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([employeeId, competencyId])
}

// Встреча из Plaud (раздел 8 ТЗ). Этап 1 закрывает только ручную загрузку
// и хранение (раздел 20 MVP: "Загрузка Transcript + Summary — ручная”).
// Транскрипт сознательно не хранится (владелец 08.09.2026: Plaud уже
// делает саммари сам, транскрипт полностью убран из проекта — было пусто
// в проде на момент удаления, миграция безопасна). enhancedSummary —
// замена "Speaker N" на реальные имена (владелец 09.09.2026): руководитель
// сам сопоставляет метки с именами (speakerNames), бэкенд делает
// подстановку без AI. Разбиение на MeetingTopic сознательно не заведено —
// это результат AI-сегментации, отдельный будущий шаг, заводить пустую
// сущность под него преждевременно.
model Meeting {
  id          String   @id @default(cuid())
  title       String
  meetingDate DateTime

  // Заполнено только у автоматически импортированных из Plaud записей
  // (владелец 08.09.2026) — null у вручную заведённых. Уникальность —
  // идемпотентность синхронизации: повторный прогон крона не создаёт
  // дубликат уже импортированной записи.
  plaudRecordingId String? @unique

  // Исходная версия — неизменна (раздел 8.1 ТЗ), чтобы всегда можно было
  // сверить с обработанной.
  rawSummary      String
  // Stage 2, Phase N (внешний аудит 21.09.2026, "Plaud summary freshness",
  // P1) — rawSummary намеренно не обновляется при изменении контента на
  // стороне Plaud (contentHash изменился — см. PlaudSyncService.syncItem),
  // но новое содержимое раньше нигде не сохранялось, просто отбрасывалось
  // после обновления title. latestSummary — то, что Plaud реально отдаёт
  // СЕЙЧАС (обновляется при каждом обнаруженном изменении); Assistant
  // должен смотреть на неё, а не только на замороженную rawSummary.
  latestSummary   String?
  enhancedSummary String?
  // {"Speaker 1": "Иван Иванов", ...} — из чего пересчитывается
  // enhancedSummary (владелец 09.09.2026). Null, пока имена не заданы.
  speakerNames Json?

  // Путь во внешнем объектном хранилище, не blob в БД (раздел 15 ТЗ).
  audioUrl      String?
  // Раздел 15 ТЗ: политика хранения — когда удалить аудио. Null — политика
  // ещё не выбрана владельцем (раздел 23, открытый вопрос ТЗ).
  audioDeleteAt DateTime?

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])

  tasks Task[]
  plaudSyncItem PlaudSyncItem?
  segments      MeetingSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stage 2, Phase K (внешний аудит 21.09.2026, "MeetingSegment + transcript
// ingestion") — раньше Assistant мог отвечать только по rawSummary/
// enhancedSummary (обобщённый пересказ), не по самому транскрипту: "что
// именно сказал Жандос про договор" требует поиска по репликам с
// таймкодами и говорящими, не по резюме. speakerLabel — та же условная
// метка ("Speaker 1" и т.п.), что уже используется в Meeting.speakerNames
// для enhancedSummary — тот же словарь можно использовать, чтобы
// подставить реальное имя и здесь, не заводя вторую систему разметки
// говорящих. speakerEmployeeId — опционально резолвится отдельно (не
// делается автоматически при импорте — см. PlaudSyncService), когда
// имя говорящего уже сопоставлено с сотрудником.
//
// ВАЖНО: реальный формат транскрипта, который отдаёт Plaud API (сам
// data_type в note_list, JSON-структура сегментов) НЕ подтверждён живым
// вызовом API в этой сессии — см. подробный комментарий у
// PlaudApiService.getTranscriptNote/parseTranscriptSegments. Модель и
// таблица корректны и протестированы независимо от этого; сама выборка
// данных из Plaud — best-effort, требует проверки на реальном аккаунте.
model MeetingSegment {
  id                String   @id @default(cuid())
  meetingId         String
  meeting           Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  order             Int
  startMs           Int
  endMs             Int
  speakerLabel      String
  speakerEmployeeId String?
  speakerEmployee   Employee? @relation(fields: [speakerEmployeeId], references: [id], onDelete: SetNull)
  text              String

  @@index([meetingId, order])
}

enum PlaudSyncStatus {
  // Найдена в списке Plaud, но у неё ещё нет готового auto_sum_note
  // (запись только что сделана, Plaud ещё её обрабатывает).
  WAITING_FOR_CONTENT
  SYNCED
  FAILED
}

// Stage 2, Phase J (внешний аудит 21.09.2026, "Plaud Sync v2") — раньше
// PlaudSyncService.pullChanges полагался ТОЛЬКО на скалярный курсор
// PlaudConnection.lastSyncedCreatedAt: запись, у которой на момент прогона
// крона ещё не было готово summary, тихо пропускалась (найдено: тот же
// метод, что и раньше, возвращался без throw), но курсор всё равно
// продвигался мимо нужного created_at — на следующем прогоне запись уже
// НИКОГДА не рассматривалась заново, даже когда Plaud заканчивал её
// обработку. Эта таблица — отдельная память "что видели, но ещё не
// синхронизировали" НЕЗАВИСИМО от курсора: WAITING_FOR_CONTENT/FAILED
// строки в пределах окна ретрая пересматриваются на каждом прогоне,
// независимо от того, куда уже успел уйти курсор.
//
// contentHash — Plaud API не отдаёт updated_at ни в списке файлов, ни в
// деталях записи (см. PlaudFileListItem/PlaudFileDetail) — единственный
// способ заметить, что содержимое записи изменилось на стороне Plaud,
// это перечитать и сравнить хэш с сохранённым.
model PlaudSyncItem {
  id               String          @id @default(cuid())
  employeeId       String
  plaudRecordingId String          @unique
  plaudCreatedAt   DateTime
  status           PlaudSyncStatus
  contentHash      String?
  errorMessage     String?
  meetingId        String?         @unique
  meeting          Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  // Stage 2, Phase L (внешний аудит 21.09.2026, "Plaud transcript
  // independence", P0) — раньше транскрипт синхронизировался ТОЛЬКО в той
  // же ветке, что и summary/title, и та ветка пропускалась целиком, если
  // contentHash (title+rawSummary) совпадал с прошлым разом — если
  // транскрипт ещё не был готов к моменту первой успешной синхронизации
  // summary, contentHash после этого больше никогда не менялся, и
  // транскрипт не подхватывался НИКОГДА. transcriptSyncedAt — отдельный,
  // независимый от contentHash признак "уже реально сохранили сегменты
  // хотя бы раз"; пока он null, PlaudSyncService.syncItem пробует
  // синхронизировать транскрипт заново на каждом прогоне (в пределах окна
  // ретрая), даже если summary/title не изменились.
  transcriptSyncedAt DateTime?
  // Stage 2, Phase M (внешний аудит 21.09.2026, "transcript freshness
  // после первого успешного sync") — transcriptSyncedAt сам по себе решал
  // задачу "транскрипт ещё не был готов вообще", но не задачу "транскрипт
  // был готов ЧАСТИЧНО (Plaud ещё дописывал его) и с тех пор вырос/
  // изменился" — once transcriptSyncedAt становился non-null, повторная
  // проверка транскрипта прекращалась навсегда, даже если summary/title не
  // менялись (Plaud не отдаёт updated_at, только перечитать и сравнить
  // хэш — тот же принцип, что contentHash у summary, но независимый:
  // summary и транскрипт — разные note/source в Plaud, меняются
  // независимо друг от друга).
  transcriptHash     String?
  lastAttemptAt    DateTime        @default(now())
  createdAt        DateTime        @default(now())
}

// Тип задачи: категория + требуемые компетенции (раздел 6.4).
// AI сначала классифицирует задачу по этому профилю, и только потом
// ищет исполнителя.
model TaskProfile {
  id          String @id @default(cuid())
  category    String
  type        String
  description String

  requiredCompetencies TaskProfileCompetency[]
  tasks                Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, type])
}

model TaskProfileCompetency {
  taskProfileId String
  taskProfile   TaskProfile @relation(fields: [taskProfileId], references: [id], onDelete: Cascade)
  competencyId  String
  competency    Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([taskProfileId, competencyId])
}

// --- Задачи (раздел 13 ТЗ) --------------------------------------------------

enum TaskStatus {
  DRAFT // Черновик
  NEW // Новая
  IN_PROGRESS // В работе
  IN_REVIEW // На проверке
  DONE // Выполнена
  RETURNED // Возвращена на доработку
  CANCELLED // Отменена (боковое состояние)
  // OVERDUE убран из схемы (аудит 10.09.2026, п. 2.1): хранимый статус
  // конкурировал с изменением статуса самим сотрудником — крон каждые 30
  // минут перетирал IN_PROGRESS обратно в OVERDUE. Просрочка теперь
  // вычисляется на лету, см. isOverdue в TasksService.
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Уровни, а не проценты (раздел 12 ТЗ) — самооценка LLM плохо
// откалибрована, показывать ложную точность не нужно.
enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  taskProfileId String?
  taskProfile   TaskProfile? @relation(fields: [taskProfileId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId  String
  creator    Employee  @relation("TaskCreator", fields: [creatorId], references: [id])

  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(DRAFT)
  dueDate  DateTime?

  // Когда TasksOverdueCron последний раз уведомил о просрочке этой задачи
  // (аудит 10.09.2026, п. 2.1) — не хранимый статус, только защита от
  // повторного уведомления каждые 30 минут. Сбрасывается в null при любом
  // изменении dueDate (см. TasksService.update).
  overdueNotifiedAt DateTime?

  // Ручной порядок внутри колонки канбана (владелец 08.09.2026: "надо
  // сделать так чтобы задачи можно было переставлять вверх-вниз"). Общий
  // default 0 у всех — сортировка по (order asc, createdAt desc) при этом
  // ведёт себя как раньше (просто "новые сверху"), пока никто ничего не
  // перетащил внутри колонки. Порядок глобальный, не per-status: канбан
  // фильтрует по status на фронте, относительный порядок внутри каждой
  // колонки от этого не зависит.
  order Int @default(0)

  // Задача поставлена AI-маршрутизацией — заполняется на Этапе 5.
  aiConfidence ConfidenceLevel?

  // Источник задачи (раздел 9 ТЗ): ссылка на встречу + точный таймкод.
  // sourceContext — краткий контекст происхождения ("почему возникла
  // задача"), безопасный к показу исполнителю без доступа к самой
  // встрече — раздел 5/9: минимальный контекст, не вся встреча целиком.
  // При ручной постановке (не из встречи) sourceMeetingId пуст, а
  // sourceContext используется как обычная заметка руководителя.
  sourceMeetingId String?
  sourceMeeting   Meeting? @relation(fields: [sourceMeetingId], references: [id])
  sourceTimestamp String?
  sourceContext   String?

  // Подзадачи (владелец 08.09.2026, по образцу Linear/Asana/Jira):
  // подзадача — обычная Task с parentTaskId, не отдельная лёгкая
  // сущность. Один уровень вложенности — сервис (не схема) отклоняет
  // попытку создать подзадачу у задачи, которая сама уже подзадача.
  // Не показываются как отдельные карточки в общем списке/канбане, только
  // внутри карточки родителя.
  parentTaskId String?
  // onDelete: Cascade (аудит 10.09.2026, п. 2.2) — раньше был дефолт Prisma
  // (SetNull): удаление родителя осиротевало подзадачи в общий список/
  // канбан как самостоятельные задачи вместо их удаления.
  parentTask Task?  @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks   Task[] @relation("TaskSubtasks")

  comments    TaskComment[]
  attachments TaskAttachment[]
  history     TaskHistory[]
  watchers    TaskWatcher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status])
  @@index([parentTaskId])
}

// Наблюдатель задачи (владелец 08.09.2026, выбрана модель «один
// ответственный + наблюдатели», как в Asana/Linear — не множественное
// назначение с правом менять статус, как в ClickUp/Monday). Наблюдатель
// видит задачу и получает уведомления, но не входит в RBAC-проверки
// смены статуса — та логика (assigneeId/creatorId) не тронута.
model TaskWatcher {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, employeeId])
  @@index([taskId])
}

model TaskComment {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   Employee @relation(fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  uploadedById String
  uploadedBy   Employee @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// Кто и что поменял в задаче — статус, исполнитель, срок (раздел 13/15).
// changedById — nullable (было обязательным): изменения от системы
// (OVERDUE-крон переводит задачу по истечении dueDate) пишутся без живого
// актора, а не от имени случайного сотрудника. Фронтенд эту историю пока
// нигде не рендерит — смена безопасна и назад совместима.
model TaskHistory {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   Employee? @relation(fields: [changedById], references: [id])
  field       String
  oldValue    String?
  newValue    String?

  createdAt DateTime @default(now())
}

// Аудит обращений к протоколам и задачам, отдельно от содержимого
// самих встреч (раздел 15 ТЗ).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      Employee @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

enum VoiceExecutionStatus {
  RECEIVED
  PROCESSING
  EXECUTING
  COMPLETED
  FAILED
  NEEDS_RECONCILIATION
}

// Stage 2, Phase H.3 (внешний аудит 21.09.2026, P0 "durable voice
// exactly-once") — VoiceService.inFlightParseRequests (in-memory Map)
// защищает только от конкурентного повтора внутри ОДНОГО живого процесса;
// после падения/рестарта процесса он ничего не знает о прошлой попытке —
// повторный /voice/parse с тем же clientRequestId, пришедший ПОСЛЕ того,
// как задача/событие уже реально созданы, но ДО того, как ответ дошёл до
// клиента (или процесс упал), выполнил бы мутацию ещё раз. Эта таблица —
// durable claim: unique(conversationId, clientRequestId) на уровне БД
// гарантирует ровно одну "владеющую" попытку на ключ, переживает рестарт.
//
// Без formal @relation на Employee/Conversation (как AuditLog.actorId
// выше не единственный такой прецедент, entityId там тоже голый String) —
// эта таблица не нуждается в каскадном удалении, важна только сама
// уникальность ключа claim'а.
model VoiceExecution {
  id             String @id @default(cuid())
  employeeId     String
  conversationId String

  clientRequestId String
  status          VoiceExecutionStatus @default(RECEIVED)

  // Полный ответ /voice/parse (без userMessage/assistantMessage — их
  // проще перечитать по id ниже) — на COMPLETED позволяет вернуть retry
  // РЕАЛЬНЫЙ results (taskId/previous и т.п.), не пустой массив, как в
  // старом findCachedParseResponse.
  resultJson         Json?
  userMessageId      String?
  assistantMessageId String?
  errorMessage       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, clientRequestId])
}

enum UndoKind {
  TASK
  EVENT
}

enum UndoRecordAction {
  CREATE
  UPDATE
}

// Stage 2, Phase H.4 (внешний аудит 21.09.2026, "trusted server-side
// undo") — заменяет прежнюю схему, где клиент сам хранил и присылал
// обратно rollback-payload (previous/addedParticipantIds/
// removedParticipantIds в VoiceUndoDto): клиент был authoritative
// источником отката, что означало, что подделанный/устаревший payload с
// фронтенда мог откатить задачу/событие в произвольное состояние. Теперь
// сервер сам строит и хранит снимок "до" сразу после мутации
// (executeTaskAction/executeEventAction, см. VoiceService), клиенту
// отдаётся только непрозрачный `id` этой записи (`undoToken`) — сам откат
// выполняется по хранимым здесь данным, не по тому, что прислал клиент.
enum UndoRecordStatus {
  // Ещё не использована — можно клеймить.
  AVAILABLE
  // Атомарно застолблена одним запросом POST /voice/undo, откат ещё
  // выполняется — второй конкурентный запрос с тем же undoToken получит
  // безопасный отказ (не AVAILABLE, значит уже занято), не выполнит откат
  // повторно.
  CLAIMED
  // Откат реально выполнился успешно.
  COMPLETED
  // Stage 2, Phase L (внешний аудит 21.09.2026, "Undo consistency", P1) —
  // раньше запись помечалась "использованной" (consumedAt) СРАЗУ при
  // claim'е, ДО попытки самого отката — если сам откат (TasksService.update/
  // EventsService.remove и т.п.) падал, запись оставалась "уже
  // использована" навсегда, и повторный клик "Отменить" получал
  // generic-отказ, хотя откат так и не произошёл. FAILED — переходное
  // состояние: VoiceService.undo при неудачном откате возвращает запись
  // обратно в AVAILABLE (в пределах expiresAt), позволяя реальный повтор.
  FAILED
  // Stage 2, Phase N (внешний аудит 21.09.2026, "undo participant
  // consistency", P1) — основной откат (поля события/задачи, либо
  // create→remove) выполнился успешно, но часть операций с участниками
  // события (addParticipant/removeParticipant при инверсии) упала.
  // Отличается от FAILED: здесь по существу "отменено", просто не до
  // конца — не возвращаем в AVAILABLE (повторный клик "Отменить" повторно
  // дёрнул бы уже откаченные поля/уже удалённую/созданную сущность), но и
  // не выдаём такой же уверенный текст, что COMPLETED — UndoRecord.warning
  // несёт детали, какой именно участник не откатился.
  PARTIAL
}

model UndoRecord {
  id         String           @id @default(cuid())
  // Чей голосовой запрос породил это действие — POST /voice/undo
  // (VoiceService.undo) сверяет вызывающего с этим полем: тот же принцип
  // "не раскрываем, какой из случаев" 404, что и у скачивания файлов
  // (см. FilesService.getDownloadStream) — не своя/несуществующая/
  // истёкшая запись отвечают одинаковым безопасным текстом.
  employeeId String
  kind       UndoKind
  action     UndoRecordAction
  entityId   String
  previous              Json?
  addedParticipantIds   Json?
  removedParticipantIds Json?

  status UndoRecordStatus @default(AVAILABLE)

  // 30 секунд от создания (VOICE_UNDO_WINDOW_MS, то же окно, что и раньше
  // проверялось только на фронте, скрывавшем кнопку "Отменить" по
  // таймеру) — теперь это ГРАНИЦА, проверяемая на сервере: раньше ничто
  // не мешало вызвать /voice/undo намного позже 30 секунд напрямую
  // (не через кнопку), полагаясь только на клиентский таймер.
  expiresAt  DateTime
  // Ставится только при переходе в COMPLETED — "когда откат реально
  // произошёл", не "когда его застолбили" (см. status выше).
  consumedAt DateTime?
  createdAt  DateTime @default(now())
}

// --- Календарь руководителя (раздел 14.2/Адъютант, скорректировано --------
// владельцем 28.08.2026) ------------------------------------------------------
//
// Внутренний календарь — источник правды в нашей системе, двусторонне
// синхронизированный с Google Calendar руководителя. Единственный писатель
// с обеих сторон — сам руководитель, поэтому конфликт-резолюция упрощена
// до last-write-wins по updatedAt/googleUpdatedAt, без сложного merge
// (в отличие от календаря с несколькими независимыми редакторами).

enum EventStatus {
  DRAFT // Черновик — например, из голосового AI-агента, ждёт подтверждения
  CONFIRMED // Подтверждено, участвует в синхронизации с Google Calendar
  CANCELLED
}

// Чья версия события правилась последней — нужно, чтобы pull-синхронизация
// не затирала локальную правку, ещё не отправленную в Google, и наоборот.
enum EventSource {
  INTERNAL
  GOOGLE
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean     @default(false)
  status      EventStatus @default(CONFIRMED)

  // Кто последним менял событие и с какой стороны — last-write-wins
  // при двусторонней синхронизации (см. комментарий к блоку выше).
  lastModifiedBy EventSource @default(INTERNAL)

  // Null, пока событие не отправлено в Google (например, ещё DRAFT).
  googleEventId String?   @unique
  // Google возвращает etag на каждое изменение — используем, чтобы
  // отличить "у нас просто устаревшая копия" от "реального конфликта".
  googleEtag    String?
  lastSyncedAt  DateTime?

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])

  // Участники встречи (владелец 09.09.2026) — раньше у события не было
  // структурного понятия "участники" вообще, только текст в title/description.
  participants EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
}

// Тот же паттерн, что TaskWatcher у задач — участник видит встречу и
// получает уведомление о добавлении, управляет только руководитель (весь
// CalendarController закрыт на OWNER).
model EventParticipant {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([eventId, employeeId])
}

// Один на сотрудника (на практике — только руководитель подключает свой
// Google Calendar). Refresh-токен хранится зашифрованным (раздел 15 ТЗ —
// AES-256), а не как есть — это первый секрет в системе, который нужно
// не только проверить, но и реально использовать повторно.
model GoogleCalendarConnection {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  googleAccountEmail    String
  refreshTokenEncrypted String
  calendarId            String @default("primary")

  // Токен инкрементальной синхронизации Google Calendar API — позволяет
  // на pull запрашивать только изменения, а не весь календарь целиком.
  syncToken String?

  // Push-уведомления Google Calendar API (events.watch) — канал живёт
  // ограниченное время и требует периодического продления кроном.
  channelId         String?
  channelResourceId String?
  channelExpiresAt  DateTime?

  connectedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSyncAt  DateTime?
}

// Единственная строка (id фиксирован как "singleton") — OAuth-клиент Google
// Cloud Console, который владелец вводит сам из личного кабинета (раздел
// 14.2 ТЗ), а не через .env/просьбу к разработчику на каждую смену.
// clientSecret шифруется тем же SecretBoxService, что и refresh-токен
// (раздел 15 ТЗ) — это тоже секрет, а не публичный идентификатор вроде
// clientId. GOOGLE_REDIRECT_URI остаётся в .env: он завязан на домен
// деплоя, а не на выбор владельца, и без пересборки не меняется всё равно.
model GoogleOAuthAppConfig {
  id                    String   @id @default("singleton")
  clientId              String
  clientSecretEncrypted String
  updatedAt             DateTime @updatedAt
}

// --- Синхронизация встреч из Plaud (владелец 08.09.2026) --------------------
// В отличие от Google Calendar выше, у Plaud нет self-service регистрации
// OAuth-приложения (portal.plaud.ai — отдельный продукт, Plaud Embedded для
// встраивания устройств в чужие приложения, не для доступа к своим же
// записям). Вместо своего OAuth-клиента используем тот же публичный
// клиент, что и официальные @plaud-ai/cli/mcp (см. PlaudOAuthService) —
// без client_secret, PKCE вместо него. Access/refresh-токены хранятся
// зашифрованными тем же SecretBoxService. У Plaud нет инкрементального
// sync-токена (в отличие от Google Calendar API) — список записей просто
// отдаёт новые первыми, поэтому курсор синхронизации — lastSyncedCreatedAt,
// а не непрозрачный токен.
model PlaudConnection {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime?

  lastSyncedCreatedAt DateTime?

  connectedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSyncAt  DateTime?
}
