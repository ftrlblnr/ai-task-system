// AI Task System — схема данных Этапа 1 (Core).
// Сущности встреч/спикеров/AI-рекомендаций (раздел 18 ТЗ) добавляются
// миграциями на Этапах 3–5, когда до них дойдёт очередь по дорожной карте.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Права доступа (раздел 5 ТЗ) -------------------------------------------

enum Role {
  OWNER // Руководитель — видит всё, подтверждает AI-назначения
  EMPLOYEE // Подчинённый — видит только свои задачи и минимальный контекст
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

// --- Профили (раздел 6 ТЗ) --------------------------------------------------

model Position {
  id        String     @id @default(cuid())
  title     String
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Направление/отдел (владелец 30.09.2026) — для фильтрации задач по
// org-unit, не по конкретному человеку. Та же лёгкая структура, что
// Position (создаётся владельцем на лету при добавлении/редактировании
// сотрудника — "можно создавать или выбирать из списка"), сознательно НЕ
// объединено с Competency: Competency — многие-ко-многим навык/компетенция
// для AI-подбора исполнителя (раздел 6.4 ТЗ), Direction — один на
// сотрудника орг-признак для фильтров в UI, разные оси.
model Direction {
  id        String     @id @default(cuid())
  title     String
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String         @id @default(cuid())
  fullName       String
  photoUrl       String?
  email          String         @unique
  passwordHash   String
  telegramId     String?        @unique
  status         EmployeeStatus @default(ACTIVE)
  role           Role           @default(EMPLOYEE)
  // Администратор профилей (раздел 6.3, 5): либо сам руководитель, либо
  // один доверенный человек — флаг, а не отдельная роль.
  isProfileAdmin Boolean        @default(false)
  // Агент поездок (ТЗ 08.10.2026, раздел 7) — trips.create: "создать
  // поездку для разрешённых руководителей", не любой сотрудник. Тот же
  // приём, что isProfileAdmin — флаг, не отдельная Role. Остальные trips.*
  // права (view/materials.add/edit/approve/manage_access/archive) —
  // per-поездка через TripMember.accessRole, не глобальный флаг.
  canCreateTrips Boolean        @default(false)

  positionId String?
  position   Position? @relation(fields: [positionId], references: [id])

  // Направление (владелец 30.09.2026, раздел фильтрации задач) — отдел/
  // подразделение (например «Маркетинг»), не путать с Position (должность,
  // например «Менеджер») и не путать с Competency (навык/компетенция для
  // AI-подбора исполнителя, many-to-many). Направление — org-unit, один на
  // сотрудника, нужен для фильтрации задач в интерфейсе руководителя.
  directionId String?
  direction   Direction? @relation(fields: [directionId], references: [id])

  competencies EmployeeCompetency[]

  tasksAssigned       Task[]             @relation("TaskAssignee")
  tasksCreated        Task[]             @relation("TaskCreator")
  taskWatching        TaskWatcher[]
  eventParticipations EventParticipant[]

  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  taskHistory         TaskHistory[]
  auditLogs           AuditLog[]
  telegramInvites     TelegramInvite[]
  passwordResetTokens PasswordResetToken[]
  meetingsCreated     Meeting[]

  eventsCreated              Event[]
  googleCalendarConnection   GoogleCalendarConnection?
  calendarPolicy             CalendarPolicy?
  calendarPlansOwned         CalendarPlan[]
  calendarAuthorizationsMade CalendarAuthorization[]
  tripsOrganized             Trip[]
  tripMemberships            TripMember[]
  agentRunsInitiated         AgentRun[]
  tripMaterialsAdded         TripMaterial[]
  plaudConnection            PlaudConnection?
  mailbox                    Mailbox?
  conversations              Conversation[]
  fileArtifacts              FileArtifact[]
  aliases                    EmployeeAlias[]
  meetingSegmentsSpoken      MeetingSegment[]

  receptionRequestsAuthored  ReceptionRequest[]
  receptionEventsActed       ReceptionEvent[]
  receptionNotificationsToMe ReceptionNotification[]

  mailActionPlansOwned    MailActionPlan[]
  mailActionApprovalsMade MailActionApproval[]
  mailWatchesOwned        MailWatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stage 2, Phase I (внешний аудит 21.09.2026, "Employee Resolver") —
// имя-варианты одного сотрудника ("Амир"/"Амиру"/"Амиром", короткие
// формы, должностные варианты), которые EmployeeResolverService
// использует В ДОПОЛНЕНИЕ к морфологической эвристике (см. её комментарий)
// при разборе assigneeRawText из голосовой команды. normalizedAlias —
// lowercase/trim/collapsed-whitespace форма alias, по ней идёт поиск;
// alias хранит оригинал для отображения в UI управления алиасами.
model EmployeeAlias {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  alias           String
  normalizedAlias String
  createdAt       DateTime @default(now())

  @@unique([employeeId, normalizedAlias])
  @@index([normalizedAlias])
}

// --- Assistant Chat (Stage 2, владелец 15.09.2026) --------------------------
// Единая лента для голоса и текста (Stage 2, Phase H, владелец 18.09.2026).
// До Phase H здесь стояла отдельная модель VoiceMessage — память голосового
// диалога (окно 3 часа) для /voice/parse, никогда не отображавшаяся ни на
// одном фронтенде (оба — apps/miniapp и apps/web — держали видимую историю
// только в localStorage). Conversation/Message/MessagePart — структурированная
// история с частями разных типов (markdown/карточки задачи-события/файл/
// статус инструмента/ошибка), а не один текстовый столбец, как раньше у
// VoiceMessage — чтобы ответ (текстовый или голосовой) мог содержать больше
// одного текстового пузыря/карточки за раз. Голос (VoiceService,
// /voice/parse) теперь тоже пишет сюда — см. комментарий в voice.service.ts.
// FileArtifact заведена в этой же миграции (нужна модели Message/Conversation
// для связи), но своей логики (хранилище, upload/download) пока не имеет —
// это отдельный этап.

enum MessageRole {
  USER
  ASSISTANT
}

// STREAMING пока не используется (нет streaming-этапа), заведён сразу,
// чтобы не потребовалась отдельная миграция только ради значения enum'а.
enum MessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

model Conversation {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  messages                  Message[]
  fileArtifacts             FileArtifact[]
  // Phase L — durable claim одного write-tool'а Assistant Core
  // (create_task_from_meeting), см. TaskFromMeetingExecution ниже.
  taskFromMeetingExecutions TaskFromMeetingExecution[]

  @@index([employeeId, updatedAt])
}

model Message {
  id              String        @id @default(cuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role            MessageRole
  status          MessageStatus @default(COMPLETED)
  // Идемпотентность повторной отправки (плохой интернет, двойной tap,
  // reconnect) — клиент генерирует один раз, сервер игнорирует повтор той
  // же пары (conversationId, clientRequestId). У сообщений ассистента
  // всегда null — Postgres не считает несколько NULL в уникальном индексе
  // конфликтующими, так что это не мешает.
  clientRequestId String?
  // Correlation id вызова ассистента, породившего это сообщение (тот же
  // принцип, что requestId в voice-пайплайне) — для логов, не для UI.
  requestId       String?

  // Phase F.1 (стабилизация, аудит 16.09.2026) — раньше пара user↔assistant
  // определялась по "первое assistant-сообщение с createdAt позже, чем у
  // user-сообщения" — на двух устройствах, отправляющих сообщения почти
  // одновременно, это могло связать ответ B с сообщением A. Явная ссылка
  // однозначна независимо от порядка времени. У user-сообщений всегда null
  // (они ни на что не отвечают), у assistant — id того user-сообщения,
  // ответом на которое оно является. @unique (Phase F.2, аудит 17.09.2026,
  // P1.7) — бизнес-правило "один основной assistant-ответ на одно
  // user-сообщение" теперь гарантирует сама БД, а не только код;
  // AssistantChatService.createAssistantMessageIdempotent ловит гонку
  // (P2002) двух одновременных запросов с одним clientRequestId.
  replyToMessageId String?   @unique
  replyToMessage   Message?  @relation("MessageReply", fields: [replyToMessageId], references: [id])
  replies          Message[] @relation("MessageReply")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts         MessagePart[]
  fileArtifacts FileArtifact[]

  @@unique([conversationId, clientRequestId])
  @@index([conversationId, createdAt])
}

// Только эти 6 типов на первом этапе (см. план этапа) — markdown/error уже
// используются, остальные три ждут своего producer'а (tool-calling для
// карточек, upload/generation для файла).
enum MessagePartType {
  MARKDOWN
  TASK_CARD
  EVENT_CARD
  FILE
  TOOL_ACTIVITY
  ERROR
}

// data — Json, не отдельные колонки на каждый тип: тот же приём, что
// AuditLog.metadata, состав полей зависит от MessagePartType и валидируется
// в коде, а не схемой БД. HTML/markdown от LLM здесь не хранится как HTML —
// только markdown-текст в MarkdownPart.data.content, санитизация — на
// фронтенде при рендере.
model MessagePart {
  id        String          @id @default(cuid())
  messageId String
  message   Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type      MessagePartType
  order     Int
  data      Json

  @@index([messageId, order])
}

enum FileArtifactSource {
  UPLOADED
  GENERATED
  INTERNAL
}

// storageProvider/storageKey — абстракция на будущий FileStorageService
// (локальный диск в разработке, S3/MinIO/Blob позже) — ничего в этой
// модели не завязано на конкретный провайдер. conversationId/messageId
// опциональны и SetNull при удалении переписки/сообщения — сам файл может
// пережить сообщение (например, если понадобится ссылка на него из аудита).
model FileArtifact {
  id             String        @id @default(cuid())
  employeeId     String
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  name            String
  mimeType        String
  size            Int
  storageProvider String
  storageKey      String
  source          FileArtifactSource

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([employeeId, createdAt])
}

// Одноразовая привязка Telegram-аккаунта к профилю сотрудника (раздел 14.2/
// 14.3 ТЗ). Руководитель не знает numeric telegram id сотрудника заранее,
// поэтому вместо ручного ввода id — приглашение: руководитель генерирует
// токен, сотрудник переходит по deep-link в бота и подтверждает себя сам.
// Хранится только хэш токена — сырой токен отдаётся один раз при создании.
model TelegramInvite {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// Самостоятельный сброс пароля (владелец 08.09.2026: единственный путь
// раньше — прямое вмешательство в БД). Тот же token/hash/TTL паттерн, что
// у TelegramInvite выше — не отдельное изобретение, а копия уже
// проверенного подхода: сырой токен отдаётся один раз, хранится только
// его хэш, 30 минут жизни, одноразовый.
model PasswordResetToken {
  id         String    @id @default(cuid())
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// Что сотрудник умеет — компетенции. Развёрнутое описание обязательно
// (раздел 6.4: точность классификации зависит от содержательности профиля,
// не от короткого тега).
model Competency {
  id          String @id @default(cuid())
  name        String @unique
  description String

  employees    EmployeeCompetency[]
  taskProfiles TaskProfileCompetency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeCompetency {
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  // Развёрнутое описание уровня/контекста владения компетенцией у ЭТОГО
  // сотрудника, не просто факт наличия.
  description  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([employeeId, competencyId])
}

// Встреча из Plaud (раздел 8 ТЗ). Этап 1 закрывает только ручную загрузку
// и хранение (раздел 20 MVP: "Загрузка Transcript + Summary — ручная”).
// Транскрипт сознательно не хранится (владелец 08.09.2026: Plaud уже
// делает саммари сам, транскрипт полностью убран из проекта — было пусто
// в проде на момент удаления, миграция безопасна). enhancedSummary —
// замена "Speaker N" на реальные имена (владелец 09.09.2026): руководитель
// сам сопоставляет метки с именами (speakerNames), бэкенд делает
// подстановку без AI. Разбиение на MeetingTopic сознательно не заведено —
// это результат AI-сегментации, отдельный будущий шаг, заводить пустую
// сущность под него преждевременно.
model Meeting {
  id          String   @id @default(cuid())
  title       String
  meetingDate DateTime

  // Заполнено только у автоматически импортированных из Plaud записей
  // (владелец 08.09.2026) — null у вручную заведённых. Уникальность —
  // идемпотентность синхронизации: повторный прогон крона не создаёт
  // дубликат уже импортированной записи.
  plaudRecordingId String? @unique

  // Исходная версия — неизменна (раздел 8.1 ТЗ), чтобы всегда можно было
  // сверить с обработанной.
  rawSummary      String
  // Stage 2, Phase N (внешний аудит 21.09.2026, "Plaud summary freshness",
  // P1) — rawSummary намеренно не обновляется при изменении контента на
  // стороне Plaud (contentHash изменился — см. PlaudSyncService.syncItem),
  // но новое содержимое раньше нигде не сохранялось, просто отбрасывалось
  // после обновления title. latestSummary — то, что Plaud реально отдаёт
  // СЕЙЧАС (обновляется при каждом обнаруженном изменении); Assistant
  // должен смотреть на неё, а не только на замороженную rawSummary.
  latestSummary   String?
  enhancedSummary String?
  // {"Speaker 1": "Иван Иванов", ...} — из чего пересчитывается
  // enhancedSummary (владелец 09.09.2026). Null, пока имена не заданы.
  speakerNames    Json?

  // Путь во внешнем объектном хранилище, не blob в БД (раздел 15 ТЗ).
  audioUrl      String?
  // Раздел 15 ТЗ: политика хранения — когда удалить аудио. Null — политика
  // ещё не выбрана владельцем (раздел 23, открытый вопрос ТЗ).
  audioDeleteAt DateTime?

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])

  tasks         Task[]
  plaudSyncItem PlaudSyncItem?
  segments      MeetingSegment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stage 2, Phase K (внешний аудит 21.09.2026, "MeetingSegment + transcript
// ingestion") — раньше Assistant мог отвечать только по rawSummary/
// enhancedSummary (обобщённый пересказ), не по самому транскрипту: "что
// именно сказал Жандос про договор" требует поиска по репликам с
// таймкодами и говорящими, не по резюме. speakerLabel — та же условная
// метка ("Speaker 1" и т.п.), что уже используется в Meeting.speakerNames
// для enhancedSummary — тот же словарь можно использовать, чтобы
// подставить реальное имя и здесь, не заводя вторую систему разметки
// говорящих. speakerEmployeeId — опционально резолвится отдельно (не
// делается автоматически при импорте — см. PlaudSyncService), когда
// имя говорящего уже сопоставлено с сотрудником.
//
// ВАЖНО: реальный формат транскрипта, который отдаёт Plaud API (сам
// data_type в note_list, JSON-структура сегментов) НЕ подтверждён живым
// вызовом API в этой сессии — см. подробный комментарий у
// PlaudApiService.getTranscriptNote/parseTranscriptSegments. Модель и
// таблица корректны и протестированы независимо от этого; сама выборка
// данных из Plaud — best-effort, требует проверки на реальном аккаунте.
model MeetingSegment {
  id                String    @id @default(cuid())
  meetingId         String
  meeting           Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  order             Int
  startMs           Int
  endMs             Int
  speakerLabel      String
  speakerEmployeeId String?
  speakerEmployee   Employee? @relation(fields: [speakerEmployeeId], references: [id], onDelete: SetNull)
  text              String

  // Phase L — задачи, поставленные Assistant'ом из этого конкретного
  // сегмента (create_task_from_meeting), см. Task.sourceSegmentId.
  sourcedTasks Task[]

  @@index([meetingId, order])
}

enum PlaudSyncStatus {
  // Найдена в списке Plaud, но у неё ещё нет готового auto_sum_note
  // (запись только что сделана, Plaud ещё её обрабатывает).
  WAITING_FOR_CONTENT
  SYNCED
  FAILED
}

// Stage 2, Phase J (внешний аудит 21.09.2026, "Plaud Sync v2") — раньше
// PlaudSyncService.pullChanges полагался ТОЛЬКО на скалярный курсор
// PlaudConnection.lastSyncedCreatedAt: запись, у которой на момент прогона
// крона ещё не было готово summary, тихо пропускалась (найдено: тот же
// метод, что и раньше, возвращался без throw), но курсор всё равно
// продвигался мимо нужного created_at — на следующем прогоне запись уже
// НИКОГДА не рассматривалась заново, даже когда Plaud заканчивал её
// обработку. Эта таблица — отдельная память "что видели, но ещё не
// синхронизировали" НЕЗАВИСИМО от курсора: WAITING_FOR_CONTENT/FAILED
// строки в пределах окна ретрая пересматриваются на каждом прогоне,
// независимо от того, куда уже успел уйти курсор.
//
// contentHash — Plaud API не отдаёт updated_at ни в списке файлов, ни в
// деталях записи (см. PlaudFileListItem/PlaudFileDetail) — единственный
// способ заметить, что содержимое записи изменилось на стороне Plaud,
// это перечитать и сравнить хэш с сохранённым.
model PlaudSyncItem {
  id                 String          @id @default(cuid())
  employeeId         String
  plaudRecordingId   String          @unique
  plaudCreatedAt     DateTime
  status             PlaudSyncStatus
  contentHash        String?
  errorMessage       String?
  meetingId          String?         @unique
  meeting            Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  // Stage 2, Phase L (внешний аудит 21.09.2026, "Plaud transcript
  // independence", P0) — раньше транскрипт синхронизировался ТОЛЬКО в той
  // же ветке, что и summary/title, и та ветка пропускалась целиком, если
  // contentHash (title+rawSummary) совпадал с прошлым разом — если
  // транскрипт ещё не был готов к моменту первой успешной синхронизации
  // summary, contentHash после этого больше никогда не менялся, и
  // транскрипт не подхватывался НИКОГДА. transcriptSyncedAt — отдельный,
  // независимый от contentHash признак "уже реально сохранили сегменты
  // хотя бы раз"; пока он null, PlaudSyncService.syncItem пробует
  // синхронизировать транскрипт заново на каждом прогоне (в пределах окна
  // ретрая), даже если summary/title не изменились.
  transcriptSyncedAt DateTime?
  // Stage 2, Phase M (внешний аудит 21.09.2026, "transcript freshness
  // после первого успешного sync") — transcriptSyncedAt сам по себе решал
  // задачу "транскрипт ещё не был готов вообще", но не задачу "транскрипт
  // был готов ЧАСТИЧНО (Plaud ещё дописывал его) и с тех пор вырос/
  // изменился" — once transcriptSyncedAt становился non-null, повторная
  // проверка транскрипта прекращалась навсегда, даже если summary/title не
  // менялись (Plaud не отдаёт updated_at, только перечитать и сравнить
  // хэш — тот же принцип, что contentHash у summary, но независимый:
  // summary и транскрипт — разные note/source в Plaud, меняются
  // независимо друг от друга).
  transcriptHash     String?
  lastAttemptAt      DateTime        @default(now())
  createdAt          DateTime        @default(now())
}

// Тип задачи: категория + требуемые компетенции (раздел 6.4).
// AI сначала классифицирует задачу по этому профилю, и только потом
// ищет исполнителя.
model TaskProfile {
  id          String @id @default(cuid())
  category    String
  type        String
  description String

  requiredCompetencies TaskProfileCompetency[]
  tasks                Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, type])
}

model TaskProfileCompetency {
  taskProfileId String
  taskProfile   TaskProfile @relation(fields: [taskProfileId], references: [id], onDelete: Cascade)
  competencyId  String
  competency    Competency  @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([taskProfileId, competencyId])
}

// --- Задачи (раздел 13 ТЗ) --------------------------------------------------

enum TaskStatus {
  DRAFT // Черновик
  NEW // Новая
  IN_PROGRESS // В работе
  IN_REVIEW // На проверке
  DONE // Выполнена
  RETURNED // Возвращена на доработку
  CANCELLED // Отменена (боковое состояние)
  // OVERDUE убран из схемы (аудит 10.09.2026, п. 2.1): хранимый статус
  // конкурировал с изменением статуса самим сотрудником — крон каждые 30
  // минут перетирал IN_PROGRESS обратно в OVERDUE. Просрочка теперь
  // вычисляется на лету, см. isOverdue в TasksService.
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Уровни, а не проценты (раздел 12 ТЗ) — самооценка LLM плохо
// откалибрована, показывать ложную точность не нужно.
enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  taskProfileId String?
  taskProfile   TaskProfile? @relation(fields: [taskProfileId], references: [id])

  assigneeId String?
  assignee   Employee? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creatorId  String
  creator    Employee  @relation("TaskCreator", fields: [creatorId], references: [id])

  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(DRAFT)
  dueDate  DateTime?

  // Когда TasksOverdueCron последний раз уведомил о просрочке этой задачи
  // (аудит 10.09.2026, п. 2.1) — не хранимый статус, только защита от
  // повторного уведомления каждые 30 минут. Сбрасывается в null при любом
  // изменении dueDate (см. TasksService.update).
  overdueNotifiedAt DateTime?

  // Ручной порядок внутри колонки канбана (владелец 08.09.2026: "надо
  // сделать так чтобы задачи можно было переставлять вверх-вниз"). Общий
  // default 0 у всех — сортировка по (order asc, createdAt desc) при этом
  // ведёт себя как раньше (просто "новые сверху"), пока никто ничего не
  // перетащил внутри колонки. Порядок глобальный, не per-status: канбан
  // фильтрует по status на фронте, относительный порядок внутри каждой
  // колонки от этого не зависит.
  order Int @default(0)

  // Задача поставлена AI-маршрутизацией — заполняется на Этапе 5.
  aiConfidence ConfidenceLevel?

  // Источник задачи (раздел 9 ТЗ): ссылка на встречу + точный таймкод.
  // sourceContext — краткий контекст происхождения ("почему возникла
  // задача"), безопасный к показу исполнителю без доступа к самой
  // встрече — раздел 5/9: минимальный контекст, не вся встреча целиком.
  // При ручной постановке (не из встречи) sourceMeetingId пуст, а
  // sourceContext используется как обычная заметка руководителя.
  sourceMeetingId String?
  sourceMeeting   Meeting?        @relation(fields: [sourceMeetingId], references: [id])
  sourceTimestamp String?
  sourceContext   String?
  // Phase O (Meeting → Task через Assistant-чат, create_task_from_meeting)
  // — машиночитаемая ссылка на точный сегмент транскрипта, если задача
  // поставлена из конкретной реплики (search_meeting_transcript), не из
  // summary целиком. sourceTimestamp/sourceContext (выше) остаются
  // человекочитаемым отображением — sourceSegmentId нужен отдельно для
  // будущей точной навигации "открыть источник → подсветить сегмент".
  // SetNull — тот же принцип, что и у sourceMeetingId: удаление
  // встречи/сегмента не должно удалять уже поставленную задачу.
  sourceSegmentId String?
  sourceSegment   MeetingSegment? @relation(fields: [sourceSegmentId], references: [id], onDelete: SetNull)

  // Hardening-раунд Phase O (22.09.2026, P0 "crash-safe idempotency") —
  // durable связь с TaskFromMeetingExecution: до этого поля идемпотентность
  // create_task_from_meeting опиралась ТОЛЬКО на то, что execution.status
  // успел обновиться в COMPLETED синхронно после prisma.task.create — если
  // процесс падал МЕЖДУ созданием Task и этим обновлением статуса, execution
  // оставался CLAIMED, через STALE_TASK_FROM_MEETING_MS становился
  // reclaimable, и retry создавал ВТОРУЮ Task для того же execution.
  // @unique на уровне БД физически не даёт двум Task сослаться на один и
  // тот же execution — retry сначала ищет Task по sourceExecutionId (сама
  // таблица Task надёжнее, чем execution.status, который мог не успеть
  // записаться), и только если её ещё нет — идёт по прежней
  // status-based reclaim-логике. SetNull — тот же принцип, что у
  // sourceMeetingId/sourceSegmentId: удаление execution-записи (её сейчас
  // никто не удаляет, но на будущее) не должно удалять уже созданную Task.
  sourceExecutionId String?                   @unique
  sourceExecution   TaskFromMeetingExecution? @relation(fields: [sourceExecutionId], references: [id], onDelete: SetNull)

  // Подзадачи (владелец 08.09.2026, по образцу Linear/Asana/Jira):
  // подзадача — обычная Task с parentTaskId, не отдельная лёгкая
  // сущность. Один уровень вложенности — сервис (не схема) отклоняет
  // попытку создать подзадачу у задачи, которая сама уже подзадача.
  // Не показываются как отдельные карточки в общем списке/канбане, только
  // внутри карточки родителя.
  parentTaskId String?
  // onDelete: Cascade (аудит 10.09.2026, п. 2.2) — раньше был дефолт Prisma
  // (SetNull): удаление родителя осиротевало подзадачи в общий список/
  // канбан как самостоятельные задачи вместо их удаления.
  parentTask   Task?   @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]  @relation("TaskSubtasks")

  comments    TaskComment[]
  attachments TaskAttachment[]
  history     TaskHistory[]
  watchers    TaskWatcher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status])
  @@index([parentTaskId])
}

// Наблюдатель задачи (владелец 08.09.2026, выбрана модель «один
// ответственный + наблюдатели», как в Asana/Linear — не множественное
// назначение с правом менять статус, как в ClickUp/Monday). Наблюдатель
// видит задачу и получает уведомления, но не входит в RBAC-проверки
// смены статуса — та логика (assigneeId/creatorId) не тронута.
model TaskWatcher {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, employeeId])
  @@index([taskId])
}

model TaskComment {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String
  author   Employee @relation(fields: [authorId], references: [id])
  body     String

  createdAt DateTime @default(now())
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  uploadedById String
  uploadedBy   Employee @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())
}

// Кто и что поменял в задаче — статус, исполнитель, срок (раздел 13/15).
// changedById — nullable (было обязательным): изменения от системы
// (OVERDUE-крон переводит задачу по истечении dueDate) пишутся без живого
// актора, а не от имени случайного сотрудника. Фронтенд эту историю пока
// нигде не рендерит — смена безопасна и назад совместима.
model TaskHistory {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  changedById String?
  changedBy   Employee? @relation(fields: [changedById], references: [id])
  field       String
  oldValue    String?
  newValue    String?

  createdAt DateTime @default(now())
}

// Аудит обращений к протоколам и задачам, отдельно от содержимого
// самих встреч (раздел 15 ТЗ).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      Employee @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

enum TaskFromMeetingStatus {
  // Застолблено, задача ещё не создана — тот же смысл, что у
  // VoiceExecution до EXECUTING (см. её комментарий), но здесь claim и
  // сама мутация происходят практически одновременно (создание одной
  // Task — не многошаговый процесс), отдельного EXECUTING не заводим.
  CLAIMED
  COMPLETED
  FAILED
}

// Stage 2, Phase O (Meeting → Task workflow, 22.09.2026) — durable
// exactly-once claim для create_task_from_meeting, первого write-tool'а
// Assistant Core (все остальные tools в assistant-tools.service.ts —
// read-only). Тот же принцип, что VoiceExecution (см. её комментарий
// выше): tool_use.id от Anthropic непригоден как ключ идемпотентности —
// при полном ретрае runReply (например, процесс упал после того, как тул
// уже создал Task, но до того, как финальное Message сохранилось) Claude
// вызывается заново и выдаёт новые tool_use id на каждый вызов.
//
// dedupeKey — hardening-раунд (22.09.2026, P0/P1): изначально был хэш от
// userMessageId + meetingId + segmentId + нормализованного title, но это
// схлопывало ДВЕ РАЗНЫЕ задачи с одинаковым title/meeting (например, один
// и тот же пункт встречи, поставленный двум разным исполнителям в одном
// ответе модели), и наоборот — не распознавало ретрай, если модель
// перефразировала title между попытками. Теперь ключ — чисто позиционная
// identity, не зависящая от LLM-generated текста: `userMessageId:
// toolCallIndex` (см. AssistantReplyService.runReply) — стабилен при
// полном ретрае одного и того же сообщения (тот же порядок вызовов даёт
// тот же индекс), и различает несколько разных вызовов в одном ответе
// (разный индекс на каждый).
//
// sourcedTask — обратная связь для Task.sourceExecutionId (hardening,
// P0 "crash-safe"): физическая durable-гарантия "максимум одна Task на
// execution" живёт как @unique на стороне Task, не здесь.
//
// Отдельная маленькая модель, не общий "ToolExecution"-фреймворк на все
// будущие write-tools — второго write-tool'а пока не существует,
// обобщать преждевременно (см. план Phase O).
model TaskFromMeetingExecution {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  dedupeKey    String
  status       TaskFromMeetingStatus @default(CLAIMED)
  taskId       String?
  errorMessage String?

  sourcedTask Task?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, dedupeKey])
}

enum VoiceExecutionStatus {
  RECEIVED
  PROCESSING
  EXECUTING
  COMPLETED
  FAILED
  NEEDS_RECONCILIATION
}

// Stage 2, Phase H.3 (внешний аудит 21.09.2026, P0 "durable voice
// exactly-once") — VoiceService.inFlightParseRequests (in-memory Map)
// защищает только от конкурентного повтора внутри ОДНОГО живого процесса;
// после падения/рестарта процесса он ничего не знает о прошлой попытке —
// повторный /voice/parse с тем же clientRequestId, пришедший ПОСЛЕ того,
// как задача/событие уже реально созданы, но ДО того, как ответ дошёл до
// клиента (или процесс упал), выполнил бы мутацию ещё раз. Эта таблица —
// durable claim: unique(conversationId, clientRequestId) на уровне БД
// гарантирует ровно одну "владеющую" попытку на ключ, переживает рестарт.
//
// Без formal @relation на Employee/Conversation (как AuditLog.actorId
// выше не единственный такой прецедент, entityId там тоже голый String) —
// эта таблица не нуждается в каскадном удалении, важна только сама
// уникальность ключа claim'а.
model VoiceExecution {
  id             String @id @default(cuid())
  employeeId     String
  conversationId String

  clientRequestId String
  status          VoiceExecutionStatus @default(RECEIVED)

  // Полный ответ /voice/parse (без userMessage/assistantMessage — их
  // проще перечитать по id ниже) — на COMPLETED позволяет вернуть retry
  // РЕАЛЬНЫЙ results (taskId/previous и т.п.), не пустой массив, как в
  // старом findCachedParseResponse.
  resultJson         Json?
  userMessageId      String?
  assistantMessageId String?
  errorMessage       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, clientRequestId])
}

enum UndoKind {
  TASK
  EVENT
}

enum UndoRecordAction {
  CREATE
  UPDATE
}

// Stage 2, Phase H.4 (внешний аудит 21.09.2026, "trusted server-side
// undo") — заменяет прежнюю схему, где клиент сам хранил и присылал
// обратно rollback-payload (previous/addedParticipantIds/
// removedParticipantIds в VoiceUndoDto): клиент был authoritative
// источником отката, что означало, что подделанный/устаревший payload с
// фронтенда мог откатить задачу/событие в произвольное состояние. Теперь
// сервер сам строит и хранит снимок "до" сразу после мутации
// (executeTaskAction/executeEventAction, см. VoiceService), клиенту
// отдаётся только непрозрачный `id` этой записи (`undoToken`) — сам откат
// выполняется по хранимым здесь данным, не по тому, что прислал клиент.
enum UndoRecordStatus {
  // Ещё не использована — можно клеймить.
  AVAILABLE
  // Атомарно застолблена одним запросом POST /voice/undo, откат ещё
  // выполняется — второй конкурентный запрос с тем же undoToken получит
  // безопасный отказ (не AVAILABLE, значит уже занято), не выполнит откат
  // повторно.
  CLAIMED
  // Откат реально выполнился успешно.
  COMPLETED
  // Stage 2, Phase L (внешний аудит 21.09.2026, "Undo consistency", P1) —
  // раньше запись помечалась "использованной" (consumedAt) СРАЗУ при
  // claim'е, ДО попытки самого отката — если сам откат (TasksService.update/
  // EventsService.remove и т.п.) падал, запись оставалась "уже
  // использована" навсегда, и повторный клик "Отменить" получал
  // generic-отказ, хотя откат так и не произошёл. FAILED — переходное
  // состояние: VoiceService.undo при неудачном откате возвращает запись
  // обратно в AVAILABLE (в пределах expiresAt), позволяя реальный повтор.
  FAILED
  // Stage 2, Phase N (внешний аудит 21.09.2026, "undo participant
  // consistency", P1) — основной откат (поля события/задачи, либо
  // create→remove) выполнился успешно, но часть операций с участниками
  // события (addParticipant/removeParticipant при инверсии) упала.
  // Отличается от FAILED: здесь по существу "отменено", просто не до
  // конца — не возвращаем в AVAILABLE (повторный клик "Отменить" повторно
  // дёрнул бы уже откаченные поля/уже удалённую/созданную сущность), но и
  // не выдаём такой же уверенный текст, что COMPLETED — UndoRecord.warning
  // несёт детали, какой именно участник не откатился.
  PARTIAL
}

model UndoRecord {
  id                    String           @id @default(cuid())
  // Чей голосовой запрос породил это действие — POST /voice/undo
  // (VoiceService.undo) сверяет вызывающего с этим полем: тот же принцип
  // "не раскрываем, какой из случаев" 404, что и у скачивания файлов
  // (см. FilesService.getDownloadStream) — не своя/несуществующая/
  // истёкшая запись отвечают одинаковым безопасным текстом.
  employeeId            String
  kind                  UndoKind
  action                UndoRecordAction
  entityId              String
  previous              Json?
  addedParticipantIds   Json?
  removedParticipantIds Json?

  status UndoRecordStatus @default(AVAILABLE)

  // 30 секунд от создания (VOICE_UNDO_WINDOW_MS, то же окно, что и раньше
  // проверялось только на фронте, скрывавшем кнопку "Отменить" по
  // таймеру) — теперь это ГРАНИЦА, проверяемая на сервере: раньше ничто
  // не мешало вызвать /voice/undo намного позже 30 секунд напрямую
  // (не через кнопку), полагаясь только на клиентский таймер.
  expiresAt  DateTime
  // Ставится только при переходе в COMPLETED — "когда откат реально
  // произошёл", не "когда его застолбили" (см. status выше).
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// --- Календарь руководителя (раздел 14.2/Адъютант, скорректировано --------
// владельцем 28.08.2026) ------------------------------------------------------
//
// Внутренний календарь — источник правды в нашей системе, двусторонне
// синхронизированный с Google Calendar руководителя. Единственный писатель
// с обеих сторон — сам руководитель, поэтому конфликт-резолюция упрощена
// до last-write-wins по updatedAt/googleUpdatedAt, без сложного merge
// (в отличие от календаря с несколькими независимыми редакторами).

enum EventStatus {
  DRAFT // Черновик — например, из голосового AI-агента, ждёт подтверждения
  CONFIRMED // Подтверждено, участвует в синхронизации с Google Calendar
  CANCELLED
}

// Чья версия события правилась последней — нужно, чтобы pull-синхронизация
// не затирала локальную правку, ещё не отправленную в Google, и наоборот.
enum EventSource {
  INTERNAL
  GOOGLE
}

model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean     @default(false)
  status      EventStatus @default(CONFIRMED)

  // Календарный агент, раздел 17 ТЗ — optimistic concurrency на правку
  // (тот же приём, что ReceptionRequest.version): клиент передаёт
  // ожидаемую версию, несовпадение → 409, а не тихая перезапись чужой
  // правки (включая правку от обратной синхронизации Google).
  version Int @default(1)

  // Кто последним менял событие и с какой стороны — last-write-wins
  // при двусторонней синхронизации (см. комментарий к блоку выше).
  lastModifiedBy EventSource @default(INTERNAL)

  // Null, пока событие не отправлено в Google (например, ещё DRAFT).
  googleEventId String?   @unique
  // Google возвращает etag на каждое изменение — используем, чтобы
  // отличить "у нас просто устаревшая копия" от "реального конфликта".
  googleEtag    String?
  lastSyncedAt  DateTime?

  createdById String
  createdBy   Employee @relation(fields: [createdById], references: [id])

  // Участники встречи (владелец 09.09.2026) — раньше у события не было
  // структурного понятия "участники" вообще, только текст в title/description.
  participants EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
}

// Тот же паттерн, что TaskWatcher у задач — участник видит встречу и
// получает уведомление о добавлении, управляет только руководитель (весь
// CalendarController закрыт на OWNER).
model EventParticipant {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([eventId, employeeId])
}

// Один на сотрудника (на практике — только руководитель подключает свой
// Google Calendar). Refresh-токен хранится зашифрованным (раздел 15 ТЗ —
// AES-256), а не как есть — это первый секрет в системе, который нужно
// не только проверить, но и реально использовать повторно.
model GoogleCalendarConnection {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  googleAccountEmail    String
  refreshTokenEncrypted String
  calendarId            String @default("primary")

  // Токен инкрементальной синхронизации Google Calendar API — позволяет
  // на pull запрашивать только изменения, а не весь календарь целиком.
  syncToken String?

  // Push-уведомления Google Calendar API (events.watch) — канал живёт
  // ограниченное время и требует периодического продления кроном.
  channelId         String?
  channelResourceId String?
  channelExpiresAt  DateTime?
  // Календарный агент, раздел 19 ТЗ — "проверять канал, resourceId и
  // секрет channel token": без него любой POST с угаданным/подслушанным
  // channelId на публичный /calendar/google/webhook запускал бы pull от
  // имени этого сотрудника. Google возвращает его назад в заголовке
  // X-Goog-Channel-Token на каждом уведомлении канала.
  channelToken      String?

  connectedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSyncAt  DateTime?
}

// Единственная строка (id фиксирован как "singleton") — OAuth-клиент Google
// Cloud Console, который владелец вводит сам из личного кабинета (раздел
// 14.2 ТЗ), а не через .env/просьбу к разработчику на каждую смену.
// clientSecret шифруется тем же SecretBoxService, что и refresh-токен
// (раздел 15 ТЗ) — это тоже секрет, а не публичный идентификатор вроде
// clientId. GOOGLE_REDIRECT_URI остаётся в .env: он завязан на домен
// деплоя, а не на выбор владельца, и без пересборки не меняется всё равно.
model GoogleOAuthAppConfig {
  id                    String   @id @default("singleton")
  clientId              String
  clientSecretEncrypted String
  updatedAt             DateTime @updatedAt
}

// Календарный ИИ-агент (ТЗ 07.10.2026), раздел 11/20 — правила доступности
// FIND_SLOTS. Один на владельца (этот деплой — один руководитель с личным
// календарём, не общая корпоративная политика). "До настройки руководителем
// публичная запись выключена" (раздел 11 ТЗ) относится к внешней записи
// (Этап 2) — для внутреннего поиска слотов (Этап 1) действуют встроенные
// значения по умолчанию (calendar-availability.ts: defaultAvailabilityPolicy),
// пока владелец не сохранил свои через PATCH /calendar/policy.
model CalendarPolicy {
  id      String   @id @default(cuid())
  ownerId String   @unique
  owner   Employee @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Optimistic concurrency на правку политики — тот же приём, что Event.version.
  version Int @default(1)

  // Фиксированное смещение (раздел 24 ТЗ: Asia/Almaty, UTC+5, без DST) —
  // полноценный IANA-часовой пояс с переходом на летнее время здесь не
  // нужен (единственный офис без DST, см. common/timezone.ts).
  timeZoneOffsetMinutes Int  @default(300)
  // [{weekday: 0-6, startMinute, endMinute}, ...] — раздел 11 ТЗ.
  workingHours          Json
  bufferMinutes         Int  @default(15)
  minNoticeHours        Int  @default(4)
  slotStepMinutes       Int  @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Синхронизация встреч из Plaud (владелец 08.09.2026) --------------------
// В отличие от Google Calendar выше, у Plaud нет self-service регистрации
// OAuth-приложения (portal.plaud.ai — отдельный продукт, Plaud Embedded для
// встраивания устройств в чужие приложения, не для доступа к своим же
// записям). Вместо своего OAuth-клиента используем тот же публичный
// клиент, что и официальные @plaud-ai/cli/mcp (см. PlaudOAuthService) —
// без client_secret, PKCE вместо него. Access/refresh-токены хранятся
// зашифрованными тем же SecretBoxService. У Plaud нет инкрементального
// sync-токена (в отличие от Google Calendar API) — список записей просто
// отдаёт новые первыми, поэтому курсор синхронизации — lastSyncedCreatedAt,
// а не непрозрачный токен.
model PlaudConnection {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  accessTokenEncrypted  String
  refreshTokenEncrypted String
  tokenExpiresAt        DateTime?

  lastSyncedCreatedAt DateTime?

  connectedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastSyncAt  DateTime?
}

// ---------------------------------------------------------------------------
// Stage 2, Phase R — Mail.ru Email Intelligence (roadmap «Phase P», 25.09.2026).
// Почта синхронизируется в локальную БД (IMAP → PostgreSQL), Assistant Core
// работает по ней, а не ходит в Mail.ru на каждый вопрос. Провайдер абстрагирован
// (EmailProvider), сейчас единственная реализация — MAIL_RU (IMAP, пароль
// приложения, хранится только зашифрованным — SecretBoxService).
// ---------------------------------------------------------------------------

enum MailProvider {
  MAIL_RU
}

enum MailboxSyncState {
  IDLE
  SYNCING
  ERROR
  PAUSED // после нескольких подряд ошибок авторизации — не долбим Mail.ru неверным паролем
}

enum EmailFolderRole {
  INBOX
  SENT
  // Раздел 15 ТЗ v2.0 (05.10.2026) — "Добавить учёт ARCHIVE/TRASH/
  // пользовательских папок и новых удалённых координат". Определяются через
  // special-use/XLIST провайдера (см. MailRuImapProvider.listFolders), не по
  // жёсткому имени — раздел 9 ТЗ.
  ARCHIVE
  DRAFTS
  JUNK
  TRASH
  OTHER
}

enum EmailReplyStatus {
  AWAITING_MY_REPLY
  REPLIED
  NO_REPLY_REQUIRED
  AWAITING_THEIR_REPLY
  UNKNOWN
}

enum EmailRecipientType {
  TO
  CC
  BCC
}

enum EmailImportance {
  CRITICAL
  IMPORTANT
  NORMAL
  LOW
}

enum EmailCategory {
  ACTION_REQUIRED
  DECISION_REQUIRED
  INFORMATION
  DOCUMENT
  COMMERCIAL
  LEGAL
  FINANCE
  PROJECT
  MEETING
  NEWSLETTER
  OTHER
}

model Mailbox {
  id                      String           @id @default(cuid())
  employeeId              String           @unique
  employee                Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  emailAddress            String
  provider                MailProvider     @default(MAIL_RU)
  // Пароль ПРИЛОЖЕНИЯ Mail.ru (не обычный пароль) — только зашифрованным,
  // никогда не отдаётся через API, не логируется, не попадает в промпт.
  appPasswordEncrypted    String
  syncEnabled             Boolean          @default(true)
  syncState               MailboxSyncState @default(IDLE)
  // Безопасный КОД последней ошибки (INVALID_CREDENTIALS/IMAP_DISABLED/...),
  // не текст исключения.
  lastError               String?
  consecutiveAuthFailures Int              @default(0)
  lastSyncedAt            DateTime?
  initialDays             Int              @default(30)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  folders  EmailFolder[]
  threads  EmailThread[]
  messages EmailMessage[]
  digests  EmailDigest[]

  mailActionPlans MailActionPlan[]
  mailDrafts      MailDraft[]
  mailWatches     MailWatch[]
}

model EmailFolder {
  id          String          @id @default(cuid())
  mailboxId   String
  mailbox     Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  path        String
  role        EmailFolderRole
  // UIDVALIDITY меняется, когда сервер перенумеровал UID — курсор lastUid тогда
  // недействителен, окно синхронизируется заново.
  uidValidity String?
  lastUid     Int             @default(0)

  messages EmailMessage[]

  @@unique([mailboxId, path])
}

model EmailThread {
  id             String           @id @default(cuid())
  mailboxId      String
  mailbox        Mailbox          @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  subjectNorm    String
  lastMessageAt  DateTime?
  lastIncomingAt DateTime?
  lastOutgoingAt DateTime?
  // Производный статус (см. reply-status.ts), пересчитывается после синка/анализа.
  replyStatus    EmailReplyStatus @default(UNKNOWN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  messages EmailMessage[]

  @@index([mailboxId, lastMessageAt])
  @@index([mailboxId, replyStatus])
}

model EmailMessage {
  id        String      @id @default(cuid())
  mailboxId String
  mailbox   Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  folderId  String
  folder    EmailFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  uid       Int

  providerMessageId String?
  internetMessageId String?

  subject     String?
  fromAddress String
  fromName    String?
  sentAt      DateTime?
  receivedAt  DateTime?

  textBody      String?
  htmlBody      String?
  // Тело обрезано (слишком большое письмо) — в БД только начало/заголовки.
  bodyTruncated Boolean @default(false)

  isRead         Boolean @default(false)
  isOutgoing     Boolean @default(false)
  hasAttachments Boolean @default(false)
  // Рассылка/автоответ по заголовкам (List-Unsubscribe, Precedence: bulk, noreply) —
  // правила без LLM (экономия токенов на анализе).
  isAutomated    Boolean @default(false)

  inReplyTo     String?
  referencesIds String[]
  threadId      String?
  thread        EmailThread? @relation(fields: [threadId], references: [id], onDelete: SetNull)

  // Письмо исчезло на сервере — не удаляем физически (traceability).
  providerMissing Boolean   @default(false)
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipients  EmailRecipient[]
  attachments EmailAttachment[]
  analysis    EmailAnalysis?

  @@unique([folderId, uid])
  @@index([mailboxId, receivedAt])
  @@index([mailboxId, internetMessageId])
  @@index([threadId])
}

model EmailRecipient {
  id             String             @id @default(cuid())
  emailMessageId String
  emailMessage   EmailMessage       @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  type           EmailRecipientType
  address        String
  name           String?

  @@index([emailMessageId])
  @@index([address])
}

// P1: только метаданные вложений (какие документы пришли). Содержимое/разбор — P2.
model EmailAttachment {
  id             String       @id @default(cuid())
  emailMessageId String
  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String?
  sizeBytes      Int?
  providerPartId String?
  fileArtifactId String?
  extractedText  String?
  summary        String?

  @@index([emailMessageId])
}

enum EmailAnalysisStatus {
  COMPLETED
  FAILED
}

model EmailAnalysis {
  id             String       @id @default(cuid())
  emailMessageId String       @unique
  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  status        EmailAnalysisStatus
  summary       String?
  // Null когда status=FAILED — попытка не выдумывает значения при сбое.
  importance    EmailImportance?
  category      EmailCategory?
  needsReply    Boolean?
  needsAction   Boolean?
  actionSummary String?
  deadline      DateTime?

  // Хэш входа анализа — повторный анализ только если состояние существенно
  // изменилось (контроль стоимости).
  inputHash  String?
  model      String?
  // Ограничивает ретраи структурно «битых» писем (см. MAX_ANALYSIS_ATTEMPTS).
  attempts   Int      @default(1)
  analyzedAt DateTime @default(now())
}

model EmailDigest {
  id          String   @id @default(cuid())
  mailboxId   String
  mailbox     Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  periodFrom  DateTime
  periodTo    DateTime
  content     Json
  generatedAt DateTime @default(now())

  @@unique([mailboxId, periodFrom, periodTo])
}

// ============ Почтовый ИИ-агент (ТЗ v2.0, 05.10.2026) ============
// Единый план анализ → предложение действий → согласование → исполнение →
// отчёт/восстановление поверх почты (раздел 1 ТЗ). ТЗ описывает это как
// замену "v1 ограничиваемого архивирования" — в ЭТОМ репозитории такой v1
// никогда не существовал (ни модели, ни API — проверено 05.10.2026, грепом
// по всей схеме и коду), почта была строго read-only (синк + анализ +
// дайджест). Поэтому всё ниже не миграция, а разработка с нуля.
//
// Схема сразу покрывает все 4 этапа ТЗ (раздел 21, шаг 2 — "реализовать
// общий план... до выпуска этапа 1"), но СЕРВИСНАЯ ЛОГИКА в этом релизе —
// только для этапа 1 (ARCHIVE/MOVE/CREATE_FOLDER/SET_READ/SET_UNREAD/
// FLAG/UNFLAG/TRASH). MailDraft/MailWatch/остальные типы MailActionType —
// заготовка под этапы 2-4, без исполнителя пока.

enum MailActionType {
  ARCHIVE
  MOVE
  CREATE_FOLDER
  SET_READ
  SET_UNREAD
  FLAG
  UNFLAG
  TRASH
  CREATE_TASK
  SAVE_ATTACHMENT
  DRAFT_REPLY
  SEND_REPLY
  FORWARD
  PROPOSE_MEETING
  CREATE_EVENT
  WATCH_REPLY
  WATCH_COMMITMENT
  DRAFT_REMINDER
}

// Раздел 7 ТЗ — три вида согласования + отдельная явно названная группа для
// корзины (раздел 9: "Корзина также подтверждается отдельной явно названной
// группой").
enum MailActionGroupType {
  MAILBOX_ORDER
  WORK_OBJECTS
  EXTERNAL_SEND
  TRASH
}

enum MailActionPlanStatus {
  ANALYZING
  READY
  EXECUTING
  DONE
  CANCELLED
}

// Раздел 16 ТЗ — ровно этот список состояний пункта плана.
enum MailActionItemStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  UNKNOWN
  SKIPPED_CHANGED
  BLOCKED_DEPENDENCY
  CANCELLED
  COMPENSATED
}

// Раздел 5 ТЗ — категории релевантности письма предложенному действию.
enum MailActionRelevance {
  RECOMMENDED
  KEEP
  NEEDS_REVIEW
  UNVERIFIED
}

enum MailActionApprovalStatus {
  ACTIVE
  CONSUMED
  EXPIRED
  SUPERSEDED
}

enum MailActionAttemptOutcome {
  SUCCEEDED
  FAILED
  UNKNOWN
}

model MailActionPlan {
  id          String   @id @default(cuid())
  ownerId     String
  owner       Employee @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mailboxId   String
  mailbox     Mailbox  @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  requestText String

  // Охват (раздел 4 ТЗ): ящик/папки/период/критерий/разрешённые типы —
  // одним Json, не отдельными колонками, состав охвата описан ТЗ подробно и
  // может расти по этапам.
  scope        Json
  snapshotAt   DateTime
  modelVersion String?
  // Раздел 4/14 ТЗ — смена критерия/папок создаёт НОВУЮ версию плана, не
  // правит старую версию на месте.
  version      Int                  @default(1)
  status       MailActionPlanStatus @default(ANALYZING)
  // Раздел 6 ТЗ — обнаружено/получено/проверено/требует просмотра/ошибки/
  // исчезло + отдельно число действий (не равно числу писем).
  coverage     Json?

  items     MailActionItem[]
  approvals MailActionApproval[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, mailboxId, createdAt])
}

model MailActionItem {
  id        String              @id @default(cuid())
  planId    String
  plan      MailActionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  type      MailActionType
  groupType MailActionGroupType

  // Раздел 7 ТЗ: "Объект — стабильный ID письма, вложения, проекта задачи
  // или встречи" — разнородный список, поэтому обычный String[], не
  // Prisma-связь (полиморфная ссылка).
  stableObjectIds String[]
  // UID/папка/UIDVALIDITY на момент snapshot — сверка "не изменилось ли"
  // перед исполнением (раздел 14/15 ТЗ).
  sourceLocators  Json

  reason      String
  evidence    Json?
  relevance   MailActionRelevance?
  parameters  Json
  payloadHash String

  // ID других MailActionItem этого же плана, от которых зависит этот пункт
  // (раздел 8 ТЗ, например MOVE зависит от CREATE_FOLDER).
  dependsOnItemIds String[]

  selected Boolean              @default(true)
  status   MailActionItemStatus @default(DRAFT)
  // Оптимистическая конкуренция на уровне пункта — тот же приём, что
  // ReceptionRequest.version (раздел 14 ТЗ: изменённые параметры требуют
  // нового согласия).
  version  Int                  @default(1)

  approvalId String?
  approval   MailActionApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  attempts      MailActionAttempt[]
  compensations MailActionCompensation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, groupType, status])
}

model MailActionApproval {
  id          String              @id @default(cuid())
  actorId     String
  actor       Employee            @relation(fields: [actorId], references: [id], onDelete: Cascade)
  planId      String
  plan        MailActionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  planVersion Int
  groupType   MailActionGroupType

  // Раздел 14 ТЗ — замороженный снимок согласованных пунктов (параметры,
  // адресаты, файлы, checksum) НА МОМЕНТ согласия, не ссылка на изменяемые
  // записи — сервер сверяет его с текущим состоянием перед каждым действием.
  itemIds                 String[]
  immutableActionSnapshot Json
  payloadHash             String
  status                  MailActionApprovalStatus @default(ACTIVE)
  approvedAt              DateTime                 @default(now())
  // Раздел 14 ТЗ — начальный настраиваемый срок актуальности согласия, 24ч.
  expiresAt               DateTime

  items     MailActionItem[]
  execution MailActionExecution?

  @@index([planId, groupType])
}

enum MailActionExecutionState {
  QUEUED
  RUNNING
  DONE
  STOPPED
}

model MailActionExecution {
  id                String                   @id @default(cuid())
  approvalId        String                   @unique
  approval          MailActionApproval       @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  state             MailActionExecutionState @default(QUEUED)
  // Раздел 16 ТЗ — агрегированные счётчики по типам действий.
  countersByType    Json?
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?

  @@index([state])
}

model MailActionAttempt {
  id                 String                    @id @default(cuid())
  actionId           String
  action             MailActionItem            @relation(fields: [actionId], references: [id], onDelete: Cascade)
  attemptNumber      Int
  // Раздел 16 ТЗ — durable intent ДО обращения к провайдеру, затем
  // подтверждённый результат.
  intent             Json
  providerResult     Json?
  destinationLocator Json?
  errorCode          String?
  outcome            MailActionAttemptOutcome?
  startedAt          DateTime                  @default(now())
  finishedAt         DateTime?

  @@index([actionId, attemptNumber])
}

enum MailDraftState {
  DRAFT
  SENT
  DISCARDED
}

// Этапы 2-3 ТЗ (DRAFT_REPLY/SEND_REPLY) — модель заведена вместе с общей
// инфраструктурой (раздел 21, шаг 2), сервис появится при выпуске этапа.
model MailDraft {
  id              String         @id @default(cuid())
  mailboxId       String
  mailbox         Mailbox        @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  sourceMessageId String?
  version         Int            @default(1)
  fromAddress     String?
  toAddresses     String[]
  ccAddresses     String[]
  bccAddresses    String[]
  subject         String?
  body            String?
  signature       String?
  attachments     Json?
  state           MailDraftState @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MailWatchStatus {
  ACTIVE
  NEEDS_REVIEW
  SATISFIED
  STOPPED
  CANNOT_VERIFY
}

// Этап 4 ТЗ (WATCH_REPLY/WATCH_COMMITMENT) — модель заведена сейчас, сервис
// появится при выпуске этого этапа.
model MailWatch {
  id          String          @id @default(cuid())
  ownerId     String
  owner       Employee        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  mailboxId   String
  mailbox     Mailbox         @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  sourceIds   String[]
  expectation String
  deadline    DateTime?
  nextCheckAt DateTime?
  expiresAt   DateTime?
  status      MailWatchStatus @default(ACTIVE)
  evidence    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MailActionCompensationStatus {
  PENDING
  DONE
  FAILED
  NOT_POSSIBLE
}

model MailActionCompensation {
  id                   String                       @id @default(cuid())
  originalActionId     String
  originalAction       MailActionItem               @relation(fields: [originalActionId], references: [id], onDelete: Cascade)
  selectedCompensation String
  approvalId           String?
  status               MailActionCompensationStatus @default(PENDING)
  result               Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ Приёмная руководителя (ТЗ v1.0, 02.10.2026) ============
// Самостоятельный модуль: обращение сотрудника к руководителю для личного
// приёма — НЕ задача таск-трекера (не создаёт Task автоматически, раздел 13
// ТЗ). Одна общая очередь на организацию (один OWNER-таргет), MVP.

enum ReceptionRequestType {
  DECISION // Решение
  APPROVAL // Согласование
  DISCUSSION // Обсуждение
  HELP // Помощь
}

enum ReceptionRequestStatus {
  WAITING
  CALLED
  COMPLETED
  REJECTED
  WITHDRAWN
}

enum ReceptionEventType {
  CREATED
  EDITED
  MOVED_TO_END
  CALLED
  REJECTED
  WITHDRAWN
  COMPLETED
  RETURNED_TO_QUEUE
}

enum ReceptionNotificationKind {
  CALLED
  REJECTED
  RETURNED_TO_QUEUE
}

enum ReceptionNotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
  SUPERSEDED
}

// Временное окно самостоятельной регистрации (владелец 02.10.2026) —
// человек сам заводит логин/пароль на сайте, затем тем же логином/паролем
// входит в Mini App внутри Telegram, и это автоматически привязывает его
// telegramId (см. TelegramService.authenticate) — без приглашения от
// руководителя. По умолчанию закрыто; руководитель открывает/закрывает
// переключателем на странице «Сотрудники», когда нужно принять новых людей,
// и закрывает обратно. Единственная запись в MVP, тот же bootstrap-паттерн
// фиксированным id, что ReceptionQueue (см. ниже).
model RegistrationWindow {
  id        String   @id @default(cuid())
  isOpen    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Единственная запись в MVP (раздел 11.1 ТЗ) — bootstrap фиксированным id в
// сервисе (upsert по PK, без гонки). nextOrder — монотонный счётчик порядка,
// назначается под транзакционной блокировкой этой строки (SELECT ... FOR
// UPDATE), не SELECT MAX(order)+1 (раздел 7.1 ТЗ — гонка под конкурентной
// подачей).
model ReceptionQueue {
  id        String             @id @default(cuid())
  nextOrder BigInt             @default(1)
  requests  ReceptionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReceptionRequest {
  id      String         @id @default(cuid())
  queueId String
  queue   ReceptionQueue @relation(fields: [queueId], references: [id])

  authorId String
  author   Employee @relation(fields: [authorId], references: [id])

  title           String
  description     String
  requestType     ReceptionRequestType
  expectedMinutes Int?
  desiredBy       DateTime?
  urgencyReason   String?

  status     ReceptionRequestStatus @default(WAITING)
  queueOrder BigInt
  // Optimistic concurrency (раздел 7.1/11.2 ТЗ) — каждое изменение передаёт
  // ожидаемую version, несовпадение → 409 VERSION_CONFLICT. Инкрементируется
  // сервисом на каждый успешный переход/правку, не триггером БД (нужен тот
  // же счётчик в одной транзакции с проверкой + в ReceptionEvent.requestVersion).
  version    Int                    @default(1)

  lastCalledAt    DateTime?
  closedAt        DateTime?
  rejectionReason String?
  resolution      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        ReceptionEvent[]
  notifications ReceptionNotification[]

  @@index([queueId, status, queueOrder, id])
  @@index([authorId, status, createdAt])
  @@index([queueId, closedAt, id])
}

model ReceptionEvent {
  id        String           @id @default(cuid())
  requestId String
  request   ReceptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  actorId String
  actor   Employee @relation(fields: [actorId], references: [id])

  type           ReceptionEventType
  // null только для CREATED — у создания нет исходного статуса.
  fromStatus     ReceptionRequestStatus?
  toStatus       ReceptionRequestStatus
  requestVersion Int
  // Изменённые поля / причина / результат — раздел 11.3 ТЗ. Содержимое
  // обращений сюда попадает (журнал — не технический лог, доступен OWNER и
  // автору), но не в обычные технические логи приложения.
  metadata       Json?

  createdAt DateTime @default(now())

  notifications ReceptionNotification[]

  @@index([requestId, createdAt])
}

// Durable outbox (раздел 10.2/11.4 ТЗ) — доставка уведомлений асинхронна и
// отделена от HTTP-запроса изменения обращения, в той же транзакции, что
// ReceptionEvent. lockedAt/lockedBy — атомарный захват воркером (SELECT ...
// FOR UPDATE SKIP LOCKED), короткий TTL блокировки — упавший воркер не
// держит запись вечно.
model ReceptionNotification {
  id        String           @id @default(cuid())
  eventId   String
  event     ReceptionEvent   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requestId String
  request   ReceptionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   Employee @relation(fields: [recipientId], references: [id])

  channel String                      @default("TELEGRAM")
  kind    ReceptionNotificationKind
  status  ReceptionNotificationStatus @default(PENDING)

  attemptCount      Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lastErrorCode     String?
  providerMessageId String?
  lockedAt          DateTime?
  lockedBy          String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  // Один intent на событие+получателя+канал+вид (раздел 11.4 ТЗ) — защита
  // от задвоения намерения уведомления при повторе операции.
  @@unique([eventId, recipientId, channel, kind])
  @@index([status, nextAttemptAt])
}

// Раздел 11.5 ТЗ — обобщённая идемпотентность HTTP-действий (не только
// Reception, но заведена для него первым модулем, который требует общего
// Idempotency-Key на мутирующих запросах). bodyHash — сверка, что повтор
// пришёл с ТЕМ ЖЕ телом (иначе 409 IDEMPOTENCY_CONFLICT, не тихая подмена
// результата). response — сохранённый ответ для точного повтора.
model IdempotencyKey {
  id          String    @id @default(cuid())
  actorId     String
  key         String
  action      String
  bodyHash    String
  // null, пока обработка не завершена — claim-паттерн (тот же принцип, что
  // TaskFromMeetingExecution.CLAIMED): строка создаётся ДО выполнения
  // обработчика, чтобы второй одновременный запрос с тем же ключом увидел
  // "уже в процессе", а не выполнил side-эффект дважды.
  statusCode  Int?
  response    Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([actorId, key])
}

// ============ Календарный ИИ-агент (ТЗ 07.10.2026) ============
// Этап 1, раздел 25 ТЗ: "проекты и согласование одиночных встреч" — план
// и его действия, согласие (Authorization) и журнал попыток исполнения.
// Архитектура намеренно повторяет MailActionPlan/Item/Approval/Execution/
// Attempt (почтовый агент, этот же проект) — тот же проверенный паттерн
// план→действия→согласие→исполнение→попытки, не изобретается заново.
// В отличие от почтового агента, здесь обычно ОДНО (редко — несколько
// зависимых) действие на план, не группы по согласованию — "проекты и
// согласование ОДИНОЧНЫХ встреч" прямо из названия шага ТЗ; сложная
// многогруповая модель согласия почтового агента здесь не нужна.

enum CalendarActionType {
  CREATE_EVENT
  UPDATE_EVENT
  RESCHEDULE_EVENT
  CANCEL_EVENT
}

enum CalendarPlanStatus {
  DRAFT
  NEEDS_APPROVAL
  APPROVED
  EXECUTING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
  EXPIRED
}

// Раздел 21 ТЗ — ровно этот список состояний действия.
enum CalendarActionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  UNKNOWN
  SKIPPED_CHANGED
  BLOCKED_DEPENDENCY
  CANCELLED
}

// Раздел 17 ТЗ — на чём основано разрешение исполнить действие.
enum CalendarAuthorizationBasis {
  DIRECT_COMMAND
  EXPLICIT_APPROVAL
  BOOKING_GRANT
  POLICY_RULE
}

enum CalendarExecutionState {
  QUEUED
  RUNNING
  DONE
  STOPPED
}

enum CalendarAttemptOutcome {
  SUCCEEDED
  FAILED
  UNKNOWN
}

model CalendarPlan {
  id          String             @id @default(cuid())
  ownerId     String
  owner       Employee           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // Исходное поручение ("intent" раздела 20 ТЗ) — свободный текст, разбор
  // на структурированные действия делает вызывающий код (ассистент/voice),
  // не этот сервис.
  requestText String
  version     Int                @default(1)
  status      CalendarPlanStatus @default(DRAFT)
  // Раздел 17 ТЗ — начальный срок актуальности плана, 24ч по умолчанию.
  expiresAt   DateTime?

  actions        CalendarAction[]
  authorizations CalendarAuthorization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, createdAt])
}

model CalendarAction {
  id     String             @id @default(cuid())
  planId String
  plan   CalendarPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  type   CalendarActionType

  // Null для CREATE_EVENT (событие ещё не существует); обязателен для
  // UPDATE_EVENT/RESCHEDULE_EVENT/CANCEL_EVENT.
  targetEventId String?
  // Версия Event, которую действие ожидает увидеть перед исполнением
  // (раздел 17 ТЗ) — EventsService.update сам атомарно её проверяет,
  // здесь — то, что было показано руководителю на момент согласования.
  beforeVersion Int?

  // Поля CreateEventDto/UpdateEventDto, подготовленные вызывающим кодом
  // (ассистент/voice) — этот сервис их не придумывает, только исполняет.
  parameters  Json
  payloadHash String

  dependsOnActionIds String[]
  status             CalendarActionStatus @default(PENDING)
  version            Int                  @default(1)

  authorizationId String?
  authorization   CalendarAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)

  attempts CalendarExecutionAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, status])
}

model CalendarAuthorization {
  id          String                     @id @default(cuid())
  actorId     String
  actor       Employee                   @relation(fields: [actorId], references: [id], onDelete: Cascade)
  planId      String
  plan        CalendarPlan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  planVersion Int
  basis       CalendarAuthorizationBasis @default(EXPLICIT_APPROVAL)

  // Раздел 14 ТЗ — замороженный снимок согласованных действий на момент
  // согласия, не ссылка на изменяемые записи.
  actionIds               String[]
  immutableActionSnapshot Json
  payloadHash             String
  approvedAt              DateTime  @default(now())
  expiresAt               DateTime
  revokedAt               DateTime?

  actions   CalendarAction[]
  execution CalendarActionExecution?

  @@index([planId])
}

model CalendarActionExecution {
  id              String                 @id @default(cuid())
  authorizationId String                 @unique
  authorization   CalendarAuthorization  @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  state           CalendarExecutionState @default(QUEUED)

  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?

  @@index([state])
}

model CalendarExecutionAttempt {
  id             String                  @id @default(cuid())
  actionId       String
  action         CalendarAction          @relation(fields: [actionId], references: [id], onDelete: Cascade)
  attemptNumber  Int
  intent         Json
  providerResult Json?
  errorCode      String?
  outcome        CalendarAttemptOutcome?
  startedAt      DateTime                @default(now())
  finishedAt     DateTime?

  @@index([actionId, attemptNumber])
}

// ===========================================================================
// Агент поездок (продуктовая концепция 08.10.2026). Приоритет 1 — "Материалы
// → поездка": загрузка пакета материалов, извлечение фактов, сборка карточки
// поездки. Приоритет 2 (версии/дифф/подтверждение изменений — TripRevision/
// ProposedChange) и Приоритет 3 (интеграции с календарём/задачами —
// IntegrationAction) из полного списка сущностей документа сознательно не
// заведены в этой миграции — появятся отдельно, когда до них дойдёт очередь.
// Отдельная модель AuditEntry тоже не заводится — уже есть общий AuditLog
// (actorId/action/entityType/entityId/metadata), поездки пишут туда же.
// ===========================================================================

// Раздел 8 ТЗ — ровно эти состояния очереди обработки пакета материалов.
enum AgentRunStatus {
  RECEIVED
  EXTRACTING
  MATCHING
  COMPOSING
  READY
  READY_WITH_ISSUES
  FAILED
}

enum TripMaterialStatus {
  PENDING
  EXTRACTED
  FAILED
  UNREADABLE
}

// Раздел 4 ТЗ — время поездки и готовность информации - разные признаки.
// UNKNOWN — дат нет совсем (приглашение без программы), поездка попадает в
// "без подтверждённых дат" независимо от любых угаданных значений.
// APPROXIMATE — есть ориентир (например, только месяц/квартал из переписки),
// EXACT — обе даты подтверждены конкретным источником.
enum TripPeriodPrecision {
  UNKNOWN
  APPROXIMATE
  EXACT
}

// Раздел 9 ТЗ — права внутри поездки. OWNER-роль сотрудника НЕ даёт
// автоматического доступа ко всем поездкам (решение: см. комментарий на
// модели TripMember) — модель прав тут отдельная, не Role enum.
enum TripAccessRole {
  ORGANIZER
  EDITOR
  APPROVER
  VIEWER
}

enum TripLegMode {
  FLIGHT
  TRAIN
  CAR
  OTHER
}

// Раздел 5 ТЗ — "забронировано"/"предложено"/"подтверждения не найдено" -
// три разных состояния, план никогда не выглядит как купленный билет.
enum TripBookingStatus {
  BOOKED
  PROPOSED
  UNCONFIRMED
}

enum TripContactRole {
  ORGANIZER_HOST
  RECEIVING_PARTY
  DELEGATE
  OTHER
}

enum ExtractedFactStatus {
  EXTRACTED
  CONFIRMED
  DISPUTED
  OUTDATED
}

// Раздел 4/9 ТЗ — карточка поездки. periodStart/periodEnd/periodPrecision
// хранят то, что РЕАЛЬНО подтверждено источниками; статус "идёт сейчас" /
// "скоро" / "без подтверждённых дат" / "завершена" вычисляется на чтении из
// этих полей + текущего времени, не хранится отдельным полем (избыточное
// дублирование состояния). cancelledAt — единственное явно хранимое
// состояние, отменённые поездки показываются отдельно и никогда не
// попадают в "завершена/посещена" (раздел 6 ТЗ).
model Trip {
  id              String              @id @default(cuid())
  humanCode       String              @unique
  title           String
  purposeSummary  String?
  organizerId     String
  organizer       Employee            @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  periodStart     DateTime?
  periodEnd       DateTime?
  periodPrecision TripPeriodPrecision @default(UNKNOWN)
  cancelledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         TripMember[]
  contacts        TripContact[]
  legs            TripLeg[]
  events          TripEvent[]
  stays           TripStay[]
  materials       TripMaterial[]
  facts           ExtractedFact[]
  agentRuns       AgentRun[]
  proposedChanges ProposedChange[]
  revisions       TripRevision[]

  @@index([organizerId, cancelledAt])
  @@index([periodStart, periodEnd])
}

// Раздел 9 ТЗ — доступ к конкретной поездке, отдельно от организационной
// роли сотрудника. Решение (не из документа буквально, но следует из его
// неоднократного акцента на приватности: "организатор не получает доступ ко
// всем поездкам", "участие во встрече не даёт доступ к чужим паспортам",
// "публичных ссылок на весь комплект по умолчанию нет") — здесь OWNER
// проекта НЕ обходит проверку членства, в отличие от большинства других
// модулей системы. Создающий OWNER становится ORGANIZER автоматически при
// создании поездки, но доступ к ЧУЖИМ поездкам требует явного TripMember.
model TripMember {
  id         String         @id @default(cuid())
  tripId     String
  trip       Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  accessRole TripAccessRole @default(VIEWER)
  createdAt  DateTime       @default(now())

  @@unique([tripId, employeeId])
  @@index([employeeId])
}

// Реальные люди/контакты поездки (принимающая сторона, делегаты и т.п.) —
// не обязательно пользователи системы, в отличие от TripMember.
model TripContact {
  id               String          @id @default(cuid())
  tripId           String
  trip             Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name             String
  role             TripContactRole @default(OTHER)
  organization     String?
  email            String?
  phone            String?
  sourceMaterialId String?
  createdAt        DateTime        @default(now())
}

// Перегон (сегмент перелёта/поездки) — раздел 3/5 ТЗ.
model TripLeg {
  id                          String            @id @default(cuid())
  tripId                      String
  trip                        Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  mode                        TripLegMode       @default(OTHER)
  fromLocation                String?
  toLocation                  String?
  departAt                    DateTime?
  departTimeZoneOffsetMinutes Int?
  arriveAt                    DateTime?
  arriveTimeZoneOffsetMinutes Int?
  carrier                     String?
  referenceCode               String?
  bookingStatus               TripBookingStatus @default(UNCONFIRMED)
  sourceMaterialId            String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  @@index([tripId, departAt])
}

// Программа поездки (раздел 3 ТЗ) — пункт без известного точного времени
// получает dateOnly (группировка по дню "без времени"), а не придуманный
// час. startAt остаётся null в этом случае.
model TripEvent {
  id                         String    @id @default(cuid())
  tripId                     String
  trip                       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title                      String
  startAt                    DateTime?
  startTimeZoneOffsetMinutes Int?
  dateOnly                   DateTime?
  endAt                      DateTime?
  location                   String?
  notes                      String?
  sourceMaterialId           String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([tripId, startAt])
  @@index([tripId, dateOnly])
}

model TripStay {
  id               String            @id @default(cuid())
  tripId           String
  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name             String?
  address          String?
  checkInAt        DateTime?
  checkOutAt       DateTime?
  bookingStatus    TripBookingStatus @default(UNCONFIRMED)
  sourceMaterialId String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tripId, checkInAt])
}

// Раздел 7/18 ТЗ — материал пакета. tripId пустой до тех пор, пока
// AgentRun не подобрал/создал поездку (материалы живут привязанными к
// своему AgentRun до COMPOSING). fileArtifactId — без формальной Prisma
// relation (тот же паттерн, что EmailAttachment.fileArtifactId) — байты
// читаются через FilesService.readBufferForProcessing по уже известному id.
model TripMaterial {
  id                String             @id @default(cuid())
  tripId            String?
  trip              Trip?              @relation(fields: [tripId], references: [id], onDelete: SetNull)
  agentRunId        String
  agentRun          AgentRun           @relation(fields: [agentRunId], references: [id], onDelete: Cascade)
  fileArtifactId    String
  processingStatus  TripMaterialStatus @default(PENDING)
  addedByEmployeeId String
  addedBy           Employee           @relation(fields: [addedByEmployeeId], references: [id], onDelete: Restrict)
  extractionIssue   String?
  createdAt         DateTime           @default(now())

  @@index([tripId])
  @@index([agentRunId])
}

// Факты, не укладывающиеся в типизированные сущности выше (виза, бюджет,
// спорные/устаревшие значения) — раздел 5 ТЗ про прослеживаемость
// (sourceId/фрагмент/время извлечения/статус). Для типизированных сущностей
// (TripLeg/TripEvent/TripStay/TripContact) происхождение несёт их
// собственное sourceMaterialId — отдельный слой сведения факт→сущность для
// v1 не заводится (сознательное упрощение).
// Полный CRUD (08.10.2026) — materialId стал String? без формальной
// Prisma-relation (была @relation(onDelete: Cascade) на TripMaterial) —
// тот же приём, что sourceMaterialId у TripLeg/TripEvent/TripStay/
// TripContact: простая строковая пометка происхождения, не настоящий
// FK. Нужно для ручного создания факта без материала (createFact,
// trip-edit.service.ts) — раньше это было физически невозможно
// (materialId был NOT NULL с обязательным FK).
model ExtractedFact {
  id          String              @id @default(cuid())
  tripId      String
  trip        Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  materialId  String?
  factKey     String
  factValue   String
  status      ExtractedFactStatus @default(EXTRACTED)
  extractedAt DateTime            @default(now())

  @@index([tripId])
}

// Раздел 8/18 ТЗ — durable job обработки одного пакета материалов. Claim-
// паттерн воркера (SELECT...FOR UPDATE SKIP LOCKED) переиспользует тот же
// подход, что reception-notifications.cron.ts/mail-action-execution.service.ts/
// calendar-action-execution.service.ts — не изобретается заново.
model AgentRun {
  id             String         @id @default(cuid())
  tripId         String?
  trip           Trip?          @relation(fields: [tripId], references: [id], onDelete: SetNull)
  status         AgentRunStatus @default(RECEIVED)
  initiatorId    String
  initiator      Employee       @relation(fields: [initiatorId], references: [id], onDelete: Restrict)
  idempotencyKey String         @unique
  errorSummary   String?
  lockedAt       DateTime?
  lockedBy       String?
  attempts       Int            @default(0)
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  materials TripMaterial[]

  @@index([status, lockedAt])
}

// Приоритет 2 ТЗ — "Добавить информацию всегда обновляет ВЫБРАННУЮ поездку,
// никогда не создаёт тихо новую" + "никогда не меняет тихо подтверждённые
// даты/время/адреса/состав поездки". Поэтому обработка пакета материалов,
// адресованного УЖЕ существующей поездке (AgentRun.tripId задан с самого
// начала, см. trips.service.ts.createRun), не пишет в Trip/TripLeg/... сама
// — только создаёт ProposedChange, применение — отдельное явное действие
// (approve). Для НОВОЙ поездки (AgentRun.tripId пуст при старте) поведение
// не меняется — прямая запись, как раньше (раздел 3 ТЗ: "карточка
// появляется сразу, без подтверждения по каждому полю" — именно для
// создания, не для обновлений).
enum ProposedChangeEntityType {
  TRIP
  TRIP_LEG
  TRIP_EVENT
  TRIP_STAY
  TRIP_CONTACT
}

enum ProposedChangeStatus {
  PENDING
  APPLIED
  REJECTED
}

model ProposedChange {
  id                   String                   @id @default(cuid())
  tripId               String
  trip                 Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  agentRunId           String?
  materialId           String?
  entityType           ProposedChangeEntityType
  // null — предложение НОВОЙ записи (новый перелёт/событие/проживание/
  // контакт), не правка существующей.
  entityId             String?
  // Заполнено только для точечных правок уровня Trip (например
  // periodEnd) — какое именно поле меняется. Для предложения новой записи
  // (entityId=null) — null, proposedValue несёт данные всей записи целиком.
  fieldKey             String?
  previousValue        Json?
  proposedValue        Json
  reason               String?
  consequences         String?
  status               ProposedChangeStatus     @default(PENDING)
  createdAt            DateTime                 @default(now())
  resolvedAt           DateTime?
  resolvedByEmployeeId String?

  @@index([tripId, status])
}

// Раздел 6 ТЗ — вкладка "История". Отдельно от общего AuditLog (тот
// write-only и нигде не читается через API) — это пользовательская лента
// изменений конкретной поездки, нужна собственная читаемая модель.
model TripRevision {
  id                  String                   @id @default(cuid())
  tripId              String
  trip                Trip                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  changeId            String?
  entityType          ProposedChangeEntityType
  entityId            String?
  summary             String
  // null — изменение внесено при изначальной сборке карточки (агент, без
  // участия человека), не ручная правка и не подтверждённое предложение.
  appliedByEmployeeId String?
  appliedAt           DateTime                 @default(now())

  @@index([tripId, appliedAt])
}
