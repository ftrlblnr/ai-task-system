# Postgres (used by infra/docker/docker-compose.yml and apps/api)
POSTGRES_USER=ai_task_system
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_task_system
DATABASE_URL="postgresql://ai_task_system:changeme@localhost:5432/ai_task_system?schema=public"

# apps/api
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
PORT=3001

# Telegram Mini App (раздел 14.2/14.3 ТЗ). Приглашение открывает Mini App
# напрямую (?startapp=<token>), сотрудник привязывает себя сам — подпись
# initData проверяется TELEGRAM_BOT_TOKEN, отдельный секрет не нужен.
# TELEGRAM_BOT_TOKEN     — токен от @BotFather; без него POST /auth/telegram
#                          всегда откажет (initData некому проверить).
# TELEGRAM_BOT_USERNAME  — без @, имя бота для deep-link.
# TELEGRAM_MINIAPP_SHORT_NAME — короткое имя Mini App, тоже из @BotFather.
# Без TELEGRAM_BOT_USERNAME/TELEGRAM_MINIAPP_SHORT_NAME приглашение всё равно
# работает — просто отдаёт токен для ручной передачи вместо ссылки.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINIAPP_SHORT_NAME=

# Календарь руководителя (раздел 14.2 ТЗ / Адъютант, 28.08.2026) —
# двусторонняя синхронизация с Google Calendar.
# ENCRYPTION_KEY — AES-256 ключ для секретов в состоянии покоя (раздел 15
#                  ТЗ), сейчас хранит зашифрованный refresh-токен Google.
#                  Сгенерировать: openssl rand -base64 32
# GOOGLE_REDIRECT_URI — должен совпадать 1-в-1 с тем, что указано в Google
#                  Cloud Console для OAuth-клиента, обычно
#                  <API_URL>/calendar/google/callback. Сам client_id/secret
#                  сюда НЕ входят (аудит 10.09.2026, п. 2.13: раньше здесь
#                  ошибочно описывались GOOGLE_CLIENT_ID/SECRET — они давно
#                  self-service: владелец вводит их в личном кабинете,
#                  хранятся в БД как GoogleOAuthAppConfig, см.
#                  google-oauth.service.ts).
# GOOGLE_CALENDAR_WEBHOOK_URL — публичный HTTPS-урл API для push-уведомлений
#                  Google Calendar (events.watch); на localhost недостижим
#                  извне, поэтому в деве можно оставить пустым — синк тогда
#                  идёт по крону раз в 15 минут вместо мгновенного push.
ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=http://localhost:3001/calendar/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=

# Синхронизация встреч из Plaud (владелец 08.09.2026, скорректировано
# 09.09.2026) — не требует переменных окружения. У Plaud нет self-service
# регистрации OAuth-приложения для этого сценария (portal.plaud.ai —
# отдельный продукт, Plaud Embedded), а браузерный OAuth-редирект через наш
# домен Plaud отклоняет на шаге подтверждения (400, воспроизведено
# эмпирически) — вместо этого владелец один раз вставляет refresh_token,
# полученный локально через `npx @plaud-ai/cli login`, в форму на /meetings.
# См. комментарий в apps/api/src/plaud/plaud-oauth.service.ts.

# Голосовой режим Mini App (раздел 14.2 ТЗ / Адъютант) — POST /voice/parse:
# аудио -> транскрипт (Whisper) -> структурированный черновик задачи/события
# (Claude). Черновик эфемерный, в БД не пишется, поэтому ключи нужны только
# apps/api. Без них /voice/parse всегда откажет — остальная система на это
# не завязана (тот же паттерн, что и с TELEGRAM_BOT_TOKEN выше).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GPT-Live (живой голос по WebRTC, Stage 2 Phase Q). Использует OPENAI_API_KEY
# выше. Пока LIVE_VOICE_ENABLED != true, POST /live/sessions отвечает 404, а
# GET /live/status -> {enabled:false} (кнопка в UI скрыта).
LIVE_VOICE_ENABLED=false
LIVE_MODEL=gpt-live-1
# Потолок длительности одной сессии (биллинг посекундный), мс.
LIVE_MAX_SESSION_MS=600000

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3001

# apps/miniapp (Telegram Mini App, раздел 14.2 ТЗ) — тот же API, свой origin
# для CORS (apps/api/src/main.ts читает MINIAPP_URL).
MINIAPP_URL=http://localhost:3005
